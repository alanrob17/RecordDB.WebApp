@model RecordDB.Shared.DTOs.ArtistRecordDiscTrackDto

@{
    ViewData["Title"] = $"{Model.TrackName} - Track Details";
    var formattedLength = ViewBag.FormattedLength as string ?? "—";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8">
        <!-- Back Navigation -->
        <div class="d-flex align-items-center justify-content-between mb-3">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> Back to Tracks
            </a>
            @if (Model.TrackId.HasValue)
            {
                <span class="badge-id">Track ID: #@Model.TrackId</span>
            }
        </div>

        <div class="app-card">
            <!-- Hero Header -->
            <div class="app-card-header colored-primary" style="background: linear-gradient(135deg, #1e1b4b 0%, #4f46e5 100%) !important;">
                <div class="d-flex align-items-center gap-3">
                    <div class="artist-avatar-lg" style="background: rgba(255,255,255,0.15); border: 2px solid rgba(255,255,255,0.3);">
                        <i class="bi bi-music-note-beamed fs-2 text-white"></i>
                    </div>
                    <div>
                        <div class="text-white-50 small fw-semibold text-uppercase">
                            Track @(Model.TrackNo?.ToString() ?? "—") &bull; Disc @Model.DiscNo
                        </div>
                        <h1 class="h3 mb-0 fw-bold text-white">
                            @(string.IsNullOrWhiteSpace(Model.TrackName) ? "Untitled Track" : Model.TrackName)
                        </h1>
                        <div class="text-white-50 small mt-1">
                            by <span class="text-white fw-semibold">@Model.ArtistName</span>
                            &mdash;
                            <a asp-controller="Record" asp-action="Details" asp-route-id="@Model.RecordId"
                               class="text-white text-decoration-underline">@Model.Name</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="app-card-body">
                <!-- Metric Cards -->
                <div class="row g-3 mb-4">
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-light rounded-3 border h-100">
                            <div class="text-muted small fw-semibold text-uppercase">Track No.</div>
                            <div class="fs-4 fw-bold text-dark mt-1">@(Model.TrackNo?.ToString() ?? "—")</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-light rounded-3 border h-100">
                            <div class="text-muted small fw-semibold text-uppercase">Length</div>
                            <div class="fs-5 fw-bold text-dark mt-1">
                                @if (formattedLength != "—")
                                {
                                    <span><i class="bi bi-clock text-primary me-1"></i>@formattedLength</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-light rounded-3 border h-100">
                            <div class="text-muted small fw-semibold text-uppercase">Disc</div>
                            <div class="fs-5 fw-bold text-dark mt-1">
                                <a asp-controller="Disc" asp-action="Details" asp-route-id="@Model.DiscId"
                                   class="text-primary text-decoration-none fw-semibold">Disc @Model.DiscNo</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-light rounded-3 border h-100">
                            <div class="text-muted small fw-semibold text-uppercase">Album</div>
                            <div class="fs-6 fw-semibold text-dark mt-1">
                                <a asp-controller="Record" asp-action="Details" asp-route-id="@Model.RecordId"
                                   class="text-primary text-decoration-none">@Model.Name</a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Secondary Metadata -->
                <div class="card bg-white border rounded-3 mb-4">
                    <div class="card-body">
                        <dl class="row mb-0 small">
                            <dt class="col-sm-4 text-muted">Artist</dt>
                            <dd class="col-sm-8 fw-semibold text-dark">@Model.ArtistName</dd>

                            <dt class="col-sm-4 text-muted">Album</dt>
                            <dd class="col-sm-8 text-dark">
                                <a asp-controller="Record" asp-action="Details" asp-route-id="@Model.RecordId"
                                   class="text-primary text-decoration-none">@Model.Name</a>
                            </dd>

                            <dt class="col-sm-4 text-muted">Disc</dt>
                            <dd class="col-sm-8 text-dark">
                                <a asp-controller="Disc" asp-action="Details" asp-route-id="@Model.DiscId"
                                   class="text-primary text-decoration-none">Disc @Model.DiscNo</a>
                                @if (Model.FreeDbDiscId.HasValue)
                                {
                                    <span class="text-muted ms-2">(FreeDb: @Model.FreeDbDiscId)</span>
                                }
                            </dd>

                            <dt class="col-sm-4 text-muted">Length (seconds)</dt>
                            <dd class="col-sm-8 text-dark">
                                @(Model.TrackLength.HasValue ? $"{Model.TrackLength} s" : "—")
                            </dd>
                        </dl>
                    </div>
                </div>

                <!-- Extended Info -->
                @if (!string.IsNullOrWhiteSpace(Model.Extended))
                {
                    <div>
                        <h5 class="fw-bold text-dark d-flex align-items-center gap-2 mb-3">
                            <i class="bi bi-info-circle text-primary"></i> Extended Info / Notes
                        </h5>
                        <div class="p-3 rounded-3 bg-light border" style="white-space: pre-wrap; line-height: 1.65; color: #334155;">
                            @Model.Extended
                        </div>
                    </div>
                }
            </div>

            <!-- Actions Footer -->
            <div class="app-card-footer d-flex flex-column flex-sm-row justify-content-between gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary order-2 order-sm-1">
                    <i class="bi bi-arrow-left"></i> Back to Tracks
                </a>
                @if (Model.TrackId.HasValue)
                {
                    <div class="d-flex gap-2 order-1 order-sm-2">
                        <a asp-action="Edit" asp-route-id="@Model.TrackId" class="btn btn-success flex-fill">
                            <i class="bi bi-pencil-square"></i> Edit Track
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.TrackId" class="btn btn-danger flex-fill">
                            <i class="bi bi-trash"></i> Delete
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
