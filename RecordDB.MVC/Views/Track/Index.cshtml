@model RecordDB.MVC.Models.PaginatedViewModel<RecordDB.Shared.DTOs.ArtistRecordDiscTrackDto>

@{
    ViewData["Title"] = "Tracks";
    var formatLength = ViewBag.FormatLength as Func<int?, string> ?? (_ => "—");
}

<!-- Page Header & Action Bar -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1 fw-bold text-dark d-flex align-items-center gap-2">
            <i class="bi bi-music-note-list text-primary"></i> Tracks
            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill fs-6 fw-semibold">
                @Model.TotalCount @(Model.TotalCount == 1 ? "track" : "tracks")
            </span>
        </h1>
        <p class="text-muted mb-0 small">Search and manage individual tracks across your music collection.</p>
    </div>

    <div class="d-flex flex-column flex-sm-row gap-2">
        <form method="get" asp-action="Index" class="d-flex gap-1">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" name="search" value="@Model.SearchTerm" class="form-control border-start-0"
                       placeholder="Search by track name..." style="min-width: 180px;" />
                @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary border-start-0" title="Clear search">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
                <button type="submit" class="btn btn-primary">Search</button>
            </div>
        </form>

        <a asp-action="Create" class="btn btn-primary text-nowrap">
            <i class="bi bi-plus-circle-fill"></i> New Track
        </a>
    </div>
</div>

<!-- Success Banner -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-check-circle-fill fs-5 text-success"></i>
        <div>@TempData["Success"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Items.Any())
{
    <div class="app-card text-center py-5 px-3">
        <div class="mb-3">
            <i class="bi bi-music-note-list text-muted" style="font-size: 3rem;"></i>
        </div>
        <h4 class="fw-semibold">No tracks found</h4>
        <p class="text-muted mb-3">
            @(string.IsNullOrWhiteSpace(Model.SearchTerm)
                ? "Your track library is currently empty."
                : $"No tracks matched \"{Model.SearchTerm}\".")
        </p>
        <div>
            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
            {
                <a asp-action="Index" class="btn btn-outline-secondary me-2">
                    <i class="bi bi-arrow-left"></i> View All Tracks
                </a>
            }
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Add New Track
            </a>
        </div>
    </div>
}
else
{
    <!-- ======================================================================
         Desktop Table (lg+)
         ====================================================================== -->
    <div class="app-card d-none d-lg-block mb-4">
        <div class="table-responsive">
            <table class="table table-custom align-middle">
                <thead>
                    <tr>
                        <th style="width: 70px;">#</th>
                        <th>Track Name</th>
                        <th>Artist</th>
                        <th>Album</th>
                        <th style="width: 80px;">Disc</th>
                        <th style="width: 75px;">Length</th>
                        <th>Extended Info</th>
                        <th class="text-end" style="width: 250px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var track in Model.Items)
                    {
                        <tr>
                            <td>
                                <span class="badge-id">@(track.TrackNo?.ToString() ?? "—")</span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-music-note text-primary"></i>
                                    <span class="fw-semibold text-dark">
                                        @(string.IsNullOrWhiteSpace(track.TrackName) ? "Untitled" : track.TrackName)
                                    </span>
                                </div>
                            </td>
                            <td class="text-muted small">@track.ArtistName</td>
                            <td>
                                @if (track.RecordId > 0)
                                {
                                    <a asp-controller="Record" asp-action="Details" asp-route-id="@track.RecordId"
                                       class="text-decoration-none text-primary small fw-medium">@track.Name</a>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td class="text-center">
                                <span class="badge bg-secondary bg-opacity-10 text-secondary border">
                                    D@(track.DiscNo)
                                </span>
                            </td>
                            <td>
                                @if (track.TrackLength.HasValue && track.TrackLength > 0)
                                {
                                    <span class="text-muted small">@formatLength(track.TrackLength)</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-muted small text-truncate" style="max-width: 160px;"
                                title="@track.Extended">
                                @(string.IsNullOrWhiteSpace(track.Extended) ? "—" : track.Extended)
                            </td>
                            <td class="text-end text-nowrap">
                                @if (track.TrackId.HasValue)
                                {
                                    <a asp-action="Details" asp-route-id="@track.TrackId"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i> Details
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@track.TrackId"
                                       class="btn btn-sm btn-success">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@track.TrackId"
                                       class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ======================================================================
         Mobile/Tablet Cards (< lg)
         ====================================================================== -->
    <div class="d-lg-none mb-4">
        <div class="row g-3">
            @foreach (var track in Model.Items)
            {
                <div class="col-12 col-md-6">
                    <div class="mobile-artist-card">
                        <div class="d-flex align-items-start justify-content-between mb-2">
                            <div class="d-flex align-items-center gap-2 flex-fill">
                                <div class="artist-avatar" style="background: linear-gradient(135deg, #e0e7ff 0%, #c7d2fe 100%); color: #4338ca;">
                                    <i class="bi bi-music-note"></i>
                                </div>
                                <div class="flex-fill" style="min-width: 0;">
                                    <h3 class="artist-name mb-0 text-truncate">
                                        @(string.IsNullOrWhiteSpace(track.TrackName) ? "Untitled" : track.TrackName)
                                    </h3>
                                    <div class="artist-sub text-truncate">
                                        @track.ArtistName &mdash; @track.Name
                                    </div>
                                </div>
                            </div>
                            @if (track.TrackNo.HasValue)
                            {
                                <span class="badge-id ms-2">#@track.TrackNo</span>
                            }
                        </div>

                        <div class="d-flex flex-wrap gap-2 my-2 small">
                            <span class="badge bg-secondary bg-opacity-10 text-secondary border">
                                Disc @track.DiscNo
                            </span>
                            @if (track.TrackLength.HasValue && track.TrackLength > 0)
                            {
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-clock"></i> @formatLength(track.TrackLength)
                                </span>
                            }
                            @if (!string.IsNullOrWhiteSpace(track.Extended))
                            {
                                <span class="text-muted text-truncate" style="max-width: 180px;" title="@track.Extended">
                                    @track.Extended
                                </span>
                            }
                        </div>

                        @if (track.TrackId.HasValue)
                        {
                            <div class="mobile-actions">
                                <a asp-action="Details" asp-route-id="@track.TrackId"
                                   class="btn btn-outline-primary">
                                    <i class="bi bi-eye"></i> Details
                                </a>
                                <a asp-action="Edit" asp-route-id="@track.TrackId"
                                   class="btn btn-success">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@track.TrackId"
                                   class="btn btn-danger">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- ======================================================================
         Pagination
         ====================================================================== -->
    @if (Model.TotalPages > 1)
    {
        <div class="app-card p-3 mb-4">
            <!-- Desktop / Tablet -->
            <div class="d-none d-md-flex align-items-center justify-content-between flex-wrap gap-3">
                <div class="text-muted small">
                    Showing <strong>@((Model.CurrentPage - 1) * Model.PageSize + 1)</strong> to
                    <strong>@Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount)</strong> of
                    <strong>@Model.TotalCount</strong> tracks
                </div>
                <nav aria-label="Track pagination">
                    <ul class="pagination pagination-sm flex-wrap">
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@Model.SearchTerm">
                                <i class="bi bi-chevron-left"></i> Prev
                            </a>
                        </li>
                        @if (Model.HasPreviousBlock)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Index"
                                   asp-route-page="@Model.PreviousBlockFirstPage" asp-route-search="@Model.SearchTerm">&laquo; Prev 15</a>
                            </li>
                            <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                        }
                        @for (int p = Model.BlockStart; p <= Model.BlockEnd; p++)
                        {
                            <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-page="@p" asp-route-search="@Model.SearchTerm">@p</a>
                            </li>
                        }
                        @if (Model.HasNextBlock)
                        {
                            <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                            <li class="page-item">
                                <a class="page-link" asp-action="Index"
                                   asp-route-page="@Model.NextBlockFirstPage" asp-route-search="@Model.SearchTerm">Next 15 &raquo;</a>
                            </li>
                        }
                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@Model.SearchTerm">
                                Next <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>

            <!-- Mobile -->
            <div class="d-md-none">
                <div class="mobile-pagination-bar mb-2">
                    <a class="btn btn-outline-secondary @(!Model.HasPreviousPage ? "disabled" : "")"
                       asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@Model.SearchTerm">
                        <i class="bi bi-chevron-left"></i> Prev
                    </a>
                    <span class="badge bg-light text-dark border px-3 py-2 fs-6">Page @Model.CurrentPage of @Model.TotalPages</span>
                    <a class="btn btn-outline-secondary @(!Model.HasNextPage ? "disabled" : "")"
                       asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@Model.SearchTerm">
                        Next <i class="bi bi-chevron-right"></i>
                    </a>
                </div>
                <div class="text-center text-muted small mt-2">
                    Tracks @((Model.CurrentPage - 1) * Model.PageSize + 1) &ndash; @Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount) of @Model.TotalCount
                </div>
            </div>
        </div>
    }
}
