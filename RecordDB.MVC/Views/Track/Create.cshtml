@model RecordDB.Shared.DTOs.CreateTrackDto

@{
    ViewData["Title"] = "New Track";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-9 col-lg-7">
        <div class="mb-3">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> Back to Tracks
            </a>
        </div>

        <div class="app-card">
            <div class="app-card-header colored-primary" style="background: linear-gradient(135deg, #1e1b4b 0%, #4f46e5 100%) !important;">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-music-note-plus fs-4 text-white"></i>
                    <div>
                        <h1 class="h4 mb-0 fw-bold text-white">Add New Track</h1>
                        <span class="text-white-50 small">Attach a track to a disc in your collection</span>
                    </div>
                </div>
            </div>

            <div class="app-card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger d-flex align-items-center gap-2 mb-3" role="alert">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <div>Please check the errors below.</div>
                    </div>

                    <!-- Disc Selection -->
                    <div class="mb-3">
                        <label asp-for="DiscId" class="form-label">Disc <span class="text-danger">*</span></label>
                        <select asp-for="DiscId" asp-items="ViewBag.Discs" class="form-select">
                            <option value="">-- Select a Disc --</option>
                        </select>
                        <span asp-validation-for="DiscId" class="text-danger small"></span>
                        <div class="form-text text-muted small">Listed as Artist – Album Title (Disc N).</div>
                    </div>

                    <!-- Track Number & Name -->
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-sm-3">
                            <label asp-for="TrackNo" class="form-label">Track No. <span class="text-danger">*</span></label>
                            <input asp-for="TrackNo" type="number" min="1" class="form-control" placeholder="e.g. 1" />
                            <span asp-validation-for="TrackNo" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-sm-9">
                            <label asp-for="Name" class="form-label">Track Name</label>
                            <input asp-for="Name" class="form-control" placeholder="e.g. Stairway to Heaven" autofocus />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Length -->
                    <div class="mb-3">
                        <label asp-for="TrackLength" class="form-label">Length <span class="text-muted fw-normal">(optional, in seconds)</span></label>
                        <div class="input-group" style="max-width: 250px;">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-clock"></i></span>
                            <input asp-for="TrackLength" type="number" min="0" class="form-control" placeholder="e.g. 480" />
                            <span class="input-group-text bg-light text-muted">s</span>
                        </div>
                        <span asp-validation-for="TrackLength" class="text-danger small"></span>
                        <div class="form-text text-muted small">Total playing time in seconds. Leave blank if unknown.</div>
                    </div>

                    <!-- Extended Info -->
                    <div class="mb-4">
                        <label asp-for="Extended" class="form-label">Extended Info <span class="text-muted fw-normal">(optional)</span></label>
                        <input asp-for="Extended" class="form-control" placeholder="e.g. Live Version, Remastered, feat. guest artist..." />
                        <span asp-validation-for="Extended" class="text-danger small"></span>
                        <div class="form-text text-muted small">Additional notes such as live, demo, remix, featured artists, etc.</div>
                    </div>

                    <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 pt-2 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary order-2 order-sm-1">Cancel</a>
                        <button type="submit" class="btn btn-primary order-1 order-sm-2">
                            <i class="bi bi-check2-circle"></i> Create Track
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
