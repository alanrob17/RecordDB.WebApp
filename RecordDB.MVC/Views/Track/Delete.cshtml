@model RecordDB.Shared.DTOs.ArtistRecordDiscTrackDto

@{
    ViewData["Title"] = $"Delete Track {Model.TrackNo}";
    var formattedLength = ViewBag.FormattedLength as string ?? "—";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-9 col-lg-7">
        <div class="mb-3">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> Back to Tracks
            </a>
        </div>

        <div class="app-card border-danger">
            <div class="app-card-header colored-danger">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-octagon-fill fs-4 text-white"></i>
                    <div>
                        <h1 class="h4 mb-0 fw-bold text-white">Confirm Track Deletion</h1>
                        <span class="text-white-50 small">Warning: This action cannot be reversed</span>
                    </div>
                </div>
            </div>

            <div class="app-card-body">
                <div class="alert alert-danger bg-danger bg-opacity-10 border-danger border-opacity-25 text-danger d-flex align-items-start gap-2 mb-4">
                    <i class="bi bi-exclamation-triangle-fill fs-5 mt-1 flex-shrink-0"></i>
                    <div>
                        <strong>Are you sure you want to delete this track?</strong>
                        <div class="small mt-1">
                            This will permanently remove track
                            <strong>@(Model.TrackNo?.ToString() ?? "—")</strong>
                            &ldquo;<strong>@(string.IsNullOrWhiteSpace(Model.TrackName) ? "Untitled" : Model.TrackName)</strong>&rdquo;
                            from <strong>@Model.Name</strong> by <strong>@Model.ArtistName</strong>.
                        </div>
                    </div>
                </div>

                <!-- Track Preview -->
                <div class="p-3 bg-light rounded-3 border mb-3">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="artist-avatar" style="background: linear-gradient(135deg, #e0e7ff 0%, #c7d2fe 100%); color: #4338ca;">
                            <i class="bi bi-music-note"></i>
                        </div>
                        <div>
                            <h2 class="h6 mb-0 fw-bold text-dark">
                                @(string.IsNullOrWhiteSpace(Model.TrackName) ? "Untitled Track" : Model.TrackName)
                            </h2>
                            <div class="text-muted small">
                                Track @(Model.TrackNo?.ToString() ?? "—") &bull;
                                @Model.ArtistName &mdash; @Model.Name (Disc @Model.DiscNo)
                            </div>
                        </div>
                    </div>

                    <dl class="row mb-0 small">
                        <dt class="col-5 text-muted">Track ID:</dt>
                        <dd class="col-7 text-dark mb-1">#@Model.TrackId</dd>

                        <dt class="col-5 text-muted">Length:</dt>
                        <dd class="col-7 text-dark mb-1">@formattedLength</dd>

                        @if (!string.IsNullOrWhiteSpace(Model.Extended))
                        {
                            <dt class="col-5 text-muted">Extended Info:</dt>
                            <dd class="col-7 text-muted fst-italic mb-0">
                                @(Model.Extended.Length > 80 ? Model.Extended[..80] + "…" : Model.Extended)
                            </dd>
                        }
                    </dl>
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" name="id" value="@Model.TrackId" />
                    <div class="d-flex flex-column flex-sm-row justify-content-between gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary order-3 order-sm-1">Cancel</a>
                        <div class="d-flex gap-2 order-1 order-sm-2">
                            <a asp-action="Details" asp-route-id="@Model.TrackId" class="btn btn-outline-primary flex-fill">
                                <i class="bi bi-eye"></i> Details
                            </a>
                            <button type="submit" class="btn btn-danger flex-fill">
                                <i class="bi bi-trash-fill"></i> Permanently Delete
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
