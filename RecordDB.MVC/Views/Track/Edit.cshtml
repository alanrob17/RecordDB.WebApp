@model RecordDB.Shared.DTOs.UpdateTrackDto

@{
    ViewData["Title"] = $"Edit Track {Model.TrackNo}";
    var albumName  = ViewBag.AlbumName  as string;
    var artistName = ViewBag.ArtistName as string;
    var discNo     = ViewBag.DiscNo;
}

<div class="row justify-content-center">
    <div class="col-12 col-md-9 col-lg-7">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> Back to Tracks
            </a>
            <span class="badge-id">Editing Track #@Model.TrackId</span>
        </div>

        <div class="app-card">
            <div class="app-card-header colored-primary" style="background: linear-gradient(135deg, #1e1b4b 0%, #4f46e5 100%) !important;">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-pencil-square fs-4 text-white"></i>
                    <div>
                        <h1 class="h4 mb-0 fw-bold text-white">Edit Track</h1>
                        <span class="text-white-50 small">
                            Track @Model.TrackNo
                            @if (!string.IsNullOrWhiteSpace(albumName))
                            {
                                <span> &mdash; @artistName – @albumName (Disc @discNo)</span>
                            }
                        </span>
                    </div>
                </div>
            </div>

            <div class="app-card-body">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger d-flex align-items-center gap-2 mb-3" role="alert">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <div>Please check the errors below.</div>
                    </div>

                    <input type="hidden" asp-for="TrackId" />
                    <input type="hidden" asp-for="DiscId" />

                    <!-- Disc Context (read-only display) -->
                    <div class="mb-3">
                        <label class="form-label text-muted fw-semibold">Disc</label>
                        <div class="p-2 bg-light border rounded-3 d-flex align-items-center gap-2 text-dark">
                            <i class="bi bi-vinyl-fill text-primary"></i>
                            <span>
                                @(artistName ?? "—") – @(albumName ?? "—") (Disc @discNo)
                            </span>
                        </div>
                        <div class="form-text small text-muted">The disc this track belongs to cannot be changed here.</div>
                    </div>

                    <!-- Track Number & Name -->
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-sm-3">
                            <label asp-for="TrackNo" class="form-label">Track No. <span class="text-danger">*</span></label>
                            <input asp-for="TrackNo" type="number" min="1" class="form-control" />
                            <span asp-validation-for="TrackNo" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-sm-9">
                            <label asp-for="Name" class="form-label">Track Name</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Length -->
                    <div class="mb-3">
                        <label asp-for="TrackLength" class="form-label">Length <span class="text-muted fw-normal">(in seconds)</span></label>
                        <div class="input-group" style="max-width: 250px;">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-clock"></i></span>
                            <input asp-for="TrackLength" type="number" min="0" class="form-control" placeholder="Leave blank to clear" />
                            <span class="input-group-text bg-light text-muted">s</span>
                        </div>
                        <span asp-validation-for="TrackLength" class="text-danger small"></span>
                    </div>

                    <!-- Extended Info -->
                    <div class="mb-4">
                        <label asp-for="Extended" class="form-label">Extended Info</label>
                        <input asp-for="Extended" class="form-control" placeholder="e.g. Live Version, Remastered..." />
                        <span asp-validation-for="Extended" class="text-danger small"></span>
                    </div>

                    <div class="d-flex flex-column flex-sm-row justify-content-between gap-2 pt-2 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary order-3 order-sm-1">Cancel</a>
                        <div class="d-flex gap-2 order-1 order-sm-2">
                            <a asp-action="Details" asp-route-id="@Model.TrackId" class="btn btn-outline-primary flex-fill">
                                <i class="bi bi-eye"></i> Details
                            </a>
                            <button type="submit" class="btn btn-success flex-fill">
                                <i class="bi bi-check2"></i> Save Changes
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
