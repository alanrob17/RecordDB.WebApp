@model RecordDB.MVC.Models.TrackSearchViewModel

@{
    ViewData["Title"] = "Track Search";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8">

        <!-- Page Heading -->
        <div class="mb-4">
            <h1 class="h2 fw-bold text-dark d-flex align-items-center gap-2">
                <i class="bi bi-music-note-list text-primary"></i> Track Search
            </h1>
            <p class="text-muted small mb-0">
                Enter a partial or full track name to search and browse matching songs across your entire music collection.
            </p>
        </div>

        <!-- ======================================================================
             Search Form Card
             ====================================================================== -->
        <div class="app-card mb-4 shadow-sm">
            <div class="app-card-header colored-primary">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-search fs-5 text-white"></i>
                    <h2 class="h5 mb-0 fw-bold text-white">Find a Track</h2>
                </div>
            </div>

            <div class="app-card-body p-4">
                <form asp-action="Search" method="post">
                    @Html.AntiForgeryToken()

                    <!-- Validation Summary -->
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger border-0 d-flex align-items-center gap-2 mb-3" role="alert">
                            <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                            <div>
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <div>@error.ErrorMessage</div>
                                }
                            </div>
                        </div>
                    }

                    <!-- Track Name Field -->
                    <div class="mb-4">
                        <label asp-for="TrackName" class="form-label fw-semibold">
                            <i class="bi bi-music-note-beamed text-primary me-1"></i> Track Name
                        </label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-white text-muted border-end-0">
                                <i class="bi bi-search"></i>
                            </span>
                            <input asp-for="TrackName"
                                   class="form-control border-start-0"
                                   placeholder="Name..."
                                   autocomplete="off"
                                   autofocus />
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary order-2 order-sm-1 w-100 w-sm-auto">
                            <i class="bi bi-music-note-list me-1"></i> Browse All Tracks
                        </a>
                        <button type="submit" class="btn btn-primary px-4 order-1 order-sm-2 w-100 w-sm-auto">
                            <i class="bi bi-search me-1"></i> Search Tracks
                        </button>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>
