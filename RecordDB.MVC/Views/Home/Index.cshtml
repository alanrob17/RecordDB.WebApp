@section Scripts {
    <script>
        (function() {
            // Live Clock and Date
            const days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
            const months = ['January', 'February', 'March', 'April', 'May', 'June',
                'July', 'August', 'September', 'October', 'November', 'December'];

            function pad(n) { return n < 10 ? '0' + n : n; }

            function tick() {
                const now = new Date();
                let h = now.getHours(), m = now.getMinutes(), s = now.getSeconds();
                const ampm = h >= 12 ? 'pm' : 'am';
                h = h % 12 || 12;
                const clockEl = document.getElementById('clock');
                const dateEl = document.getElementById('date-display');
                if (clockEl) {
                    clockEl.textContent = pad(h) + ':' + pad(m) + ':' + pad(s) + ' ' + ampm;
                }
                if (dateEl) {
                    dateEl.textContent = days[now.getDay()] + ', ' + now.getDate() + ' ' +
                        months[now.getMonth()] + ' ' + now.getFullYear();
                }
            }

            tick();
            setInterval(tick, 1000);

            // Real-time Option Filter
            const filterInput = document.getElementById('menuFilter');
            const portalTable = document.getElementById('portalTable');
            const optionCountEl = document.getElementById('optionCount');

            if (filterInput && portalTable) {
                const rows = portalTable.querySelectorAll('tbody tr');

                filterInput.addEventListener('input', function() {
                    const query = this.value.toLowerCase().trim();
                    let visibleOptions = 0;
                    let currentHeader = null;
                    let currentHeaderHasMatches = false;

                    rows.forEach(function(row) {
                        if (row.classList.contains('category-header-row')) {
                            // Close previous header if it had no matches
                            if (currentHeader && !currentHeaderHasMatches && query !== '') {
                                currentHeader.style.display = 'none';
                            }
                            currentHeader = row;
                            currentHeaderHasMatches = false;
                            row.style.display = '';
                        } else {
                            const text = row.textContent.toLowerCase();
                            const match = query === '' || text.includes(query);
                            row.style.display = match ? '' : 'none';
                            if (match) {
                                visibleOptions++;
                                currentHeaderHasMatches = true;
                            }
                        }
                    });

                    // Handle the last category header
                    if (currentHeader && !currentHeaderHasMatches && query !== '') {
                        currentHeader.style.display = 'none';
                    }

                    if (optionCountEl) {
                        optionCountEl.textContent = visibleOptions + (visibleOptions === 1 ? ' option' : ' options');
                    }
                });
            }
        })();
    </script>
}
