@model RecordDB.Shared.DTOs.UpdateRecordDto

@{
    var hasRecord = Model != null && Model.RecordId > 0;
    ViewData["Title"] = hasRecord ? $"Edit {Model?.Name}" : "Edit Record";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8">
        <!-- Back Navigation -->
        <div class="d-flex align-items-center justify-content-between mb-3">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> Back to Records
            </a>
            @if (hasRecord && Model != null)
            {
                <span class="badge-id">Editing Record #@Model.RecordId</span>
            }
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
                <i class="bi bi-check-circle-fill flex-shrink-0"></i>
                <div>@TempData["Success"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                <div>@TempData["Error"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="app-card">
            <!-- Header -->
            <div class="app-card-header colored-primary">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-pencil-square fs-4 text-white"></i>
                    <div>
                        <h1 class="h4 mb-0 fw-bold text-white">Edit Record</h1>
                        <span class="text-white-50 small">
                            @(hasRecord && Model != null ? $"#{Model.RecordId} \u2014 {Model.Name}" : "Select an artist and record from the dropdown lists to edit")
                        </span>
                    </div>
                </div>
            </div>

            <!-- Form Body -->
            <div class="app-card-body">
                <!-- DropDown Selectors for Artist and Record -->
                <form id="recordSelectForm" method="get" asp-action="EditRecord" class="mb-4 p-3 bg-light rounded border">
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label for="artistSelector" class="form-label fw-bold text-dark mb-1">
                                <i class="bi bi-person-lines-fill me-1 text-primary"></i> 1. Select Artist
                            </label>
                            <select id="artistSelector" name="artistId" class="form-select form-select-lg" asp-items="ViewBag.ArtistList">
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label for="recordSelector" class="form-label fw-bold text-dark mb-1">
                                <i class="bi bi-disc me-1 text-primary"></i> 2. Select Artist Record
                            </label>
                            <div class="input-group">
                                <select id="recordSelector" name="recordId" class="form-select form-select-lg" asp-items="ViewBag.RecordList">
                                </select>
                                <button type="submit" id="btnLoadRecord" class="btn btn-primary px-3">
                                    <i class="bi bi-arrow-repeat"></i> Load
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="form-text text-muted small mt-2">
                        Select an artist to populate their records, then select a record to load and edit its details below.
                    </div>
                </form>

                @if (!hasRecord)
                {
                    <div class="alert alert-info d-flex align-items-center gap-2 mb-0" role="alert">
                        <i class="bi bi-info-circle-fill fs-5 flex-shrink-0"></i>
                        <div>Please select an artist and then a record from the dropdown lists above to edit its details.</div>
                    </div>
                }
                else
                {
                    <form asp-action="EditRecord" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger d-flex align-items-center gap-2 mb-3" role="alert">
                            <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                            <div>Please check the errors below.</div>
                        </div>

                        <input type="hidden" asp-for="RecordId" />

                        <!-- Artist Selection & Album Name -->
                        <div class="row g-3 mb-3">
                            <div class="col-12 col-md-6">
                                <label asp-for="ArtistId" class="form-label">Artist <span class="text-danger">*</span></label>
                                <select asp-for="ArtistId" asp-items="ViewBag.Artists" class="form-select">
                                    <option value="">-- Select an Artist --</option>
                                </select>
                                <span asp-validation-for="ArtistId" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="Name" class="form-label">Album Title <span class="text-danger">*</span></label>
                                <input asp-for="Name" class="form-control" placeholder="Album Title" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Year & Field/Genre -->
                        <div class="row g-3 mb-3">
                            <div class="col-12 col-sm-6">
                                <label asp-for="Recorded" class="form-label">Year Recorded</label>
                                <input asp-for="Recorded" type="number" class="form-control" />
                                <span asp-validation-for="Recorded" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-sm-6">
                                <label asp-for="Field" class="form-label">Field / Genre</label>
                                <input asp-for="Field" class="form-control" />
                                <span asp-validation-for="Field" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Label & Pressing -->
                        <div class="row g-3 mb-3">
                            <div class="col-12 col-sm-6">
                                <label asp-for="Label" class="form-label">Record Label</label>
                                <input asp-for="Label" class="form-control" />
                                <span asp-validation-for="Label" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-sm-6">
                                <label asp-for="Pressing" class="form-label">Pressing Country</label>
                                <input asp-for="Pressing" class="form-control" />
                                <span asp-validation-for="Pressing" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Media Format & Discs -->
                        <div class="row g-3 mb-3">
                            <div class="col-12 col-sm-6">
                                <label asp-for="Media" class="form-label">Media Format</label>
                                <input asp-for="Media" class="form-control" />
                                <span asp-validation-for="Media" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-sm-6">
                                <label asp-for="Discs" class="form-label">Number of Discs</label>
                                <input asp-for="Discs" type="number" min="1" class="form-control" />
                                <span asp-validation-for="Discs" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Rating, Cost, Bought Date -->
                        <div class="row g-3 mb-3">
                            <div class="col-12 col-sm-4">
                                <label asp-for="Rating" class="form-label">Rating</label>
                                <input asp-for="Rating" class="form-control" />
                                <span asp-validation-for="Rating" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-sm-4">
                                <label asp-for="Cost" class="form-label">Cost</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="Cost" type="number" step="0.01" class="form-control" />
                                </div>
                                <span asp-validation-for="Cost" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-sm-4">
                                <label asp-for="Bought" class="form-label">Date Bought</label>
                                <input asp-for="Bought" type="date" class="form-control" 
                                       value="@(Model?.Bought.HasValue == true ? Model.Bought.Value.ToString("yyyy-MM-dd") : "")" />
                                <span asp-validation-for="Bought" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Album Review -->
                        <div class="mb-4">
                            <label asp-for="Review" class="form-label">Album Review / Notes</label>
                            <textarea asp-for="Review" class="form-control" rows="5"></textarea>
                            <span asp-validation-for="Review" class="text-danger small"></span>
                        </div>

                        <!-- Responsive Action Footer -->
                        <div class="d-flex flex-column flex-sm-row justify-content-between gap-2 pt-2 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary order-3 order-sm-1">
                                Cancel
                            </a>

                            <div class="d-flex gap-2 order-1 order-sm-2">
                                @if (Model != null)
                                {
                                    <a asp-action="Details" asp-route-id="@Model.RecordId" class="btn btn-outline-primary flex-fill">
                                        <i class="bi bi-eye"></i> Details
                                    </a>
                                }
                                <button type="submit" class="btn btn-success flex-fill">
                                    <i class="bi bi-check2"></i> Save Changes
                                </button>
                            </div>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const artistSelector = document.getElementById('artistSelector');
            const recordSelector = document.getElementById('recordSelector');

            if (artistSelector) {
                artistSelector.addEventListener('change', function () {
                    const artistId = this.value;
                    if (artistId && parseInt(artistId, 10) > 0) {
                        window.location.href = '@Url.Action("EditRecord", "Record")?artistId=' + encodeURIComponent(artistId);
                    } else {
                        window.location.href = '@Url.Action("EditRecord", "Record")';
                    }
                });
            }

            if (recordSelector) {
                recordSelector.addEventListener('change', function () {
                    const recordId = this.value;
                    const artistId = artistSelector ? artistSelector.value : '';

                    if (recordId && parseInt(recordId, 10) > 0) {
                        let targetUrl = '@Url.Action("EditRecord", "Record")?recordId=' + encodeURIComponent(recordId);
                        if (artistId && parseInt(artistId, 10) > 0) {
                            targetUrl += '&artistId=' + encodeURIComponent(artistId);
                        }
                        window.location.href = targetUrl;
                    } else if (artistId && parseInt(artistId, 10) > 0) {
                        window.location.href = '@Url.Action("EditRecord", "Record")?artistId=' + encodeURIComponent(artistId);
                    } else {
                        window.location.href = '@Url.Action("EditRecord", "Record")';
                    }
                });
            }
        });
    </script>
}
