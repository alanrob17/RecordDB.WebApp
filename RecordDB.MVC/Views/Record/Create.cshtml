@model RecordDB.Shared.DTOs.CreateRecordDto

@{
    ViewData["Title"] = "New Record";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8">
        <!-- Back Navigation -->
        <div class="mb-3">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> Back to Records
            </a>
        </div>

        <div class="app-card">
            <!-- Header -->
            <div class="app-card-header colored-primary">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-disc-fill fs-4 text-white"></i>
                    <div>
                        <h1 class="h4 mb-0 fw-bold text-white">Add New Record</h1>
                        <span class="text-white-50 small">Enter album and release details</span>
                    </div>
                </div>
            </div>

            <!-- Form Body -->
            <div class="app-card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger d-flex align-items-center gap-2 mb-3" role="alert">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <div>Please check the errors below.</div>
                    </div>

                    <!-- Artist Selection & Album Name -->
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="ArtistId" class="form-label">Artist <span class="text-danger">*</span></label>
                            <select asp-for="ArtistId" asp-items="ViewBag.Artists" class="form-select">
                                <option value="">-- Select an Artist --</option>
                            </select>
                            <span asp-validation-for="ArtistId" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Name" class="form-label">Album Title <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" placeholder="e.g. The Dark Side of the Moon" autofocus />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Year & Field/Genre -->
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-sm-6">
                            <label asp-for="Recorded" class="form-label">Year Recorded</label>
                            <input asp-for="Recorded" type="number" class="form-control" placeholder="e.g. 1973" />
                            <span asp-validation-for="Recorded" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-sm-6">
                            <label asp-for="Field" class="form-label">Field / Genre</label>
                            <input asp-for="Field" class="form-control" placeholder="e.g. Rock, Jazz, Classical" />
                            <span asp-validation-for="Field" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Label & Pressing -->
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-sm-6">
                            <label asp-for="Label" class="form-label">Record Label</label>
                            <input asp-for="Label" class="form-control" placeholder="e.g. EMI, Columbia, Blue Note" />
                            <span asp-validation-for="Label" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-sm-6">
                            <label asp-for="Pressing" class="form-label">Pressing Country</label>
                            <input asp-for="Pressing" class="form-control" placeholder="e.g. UK, US, Japan" />
                            <span asp-validation-for="Pressing" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Media Format & Discs -->
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-sm-6">
                            <label asp-for="Media" class="form-label">Media Format</label>
                            <input asp-for="Media" class="form-control" placeholder="e.g. CD, Vinyl, Cassette" />
                            <span asp-validation-for="Media" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-sm-6">
                            <label asp-for="Discs" class="form-label">Number of Discs</label>
                            <input asp-for="Discs" type="number" min="1" class="form-control" />
                            <span asp-validation-for="Discs" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Rating, Cost, Bought Date -->
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-sm-4">
                            <label asp-for="Rating" class="form-label">Rating</label>
                            <input asp-for="Rating" class="form-control" placeholder="e.g. 5, 4.5, A" />
                            <span asp-validation-for="Rating" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-sm-4">
                            <label asp-for="Cost" class="form-label">Cost</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Cost" type="number" step="0.01" class="form-control" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="Cost" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-sm-4">
                            <label asp-for="Bought" class="form-label">Date Bought</label>
                            <input asp-for="Bought" type="date" class="form-control" />
                            <span asp-validation-for="Bought" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Album Review -->
                    <div class="mb-4">
                        <label asp-for="Review" class="form-label">Album Review / Notes</label>
                        <textarea asp-for="Review" class="form-control" rows="5" 
                                  placeholder="Write notes on sound quality, track highlights, liner notes..."></textarea>
                        <span asp-validation-for="Review" class="text-danger small"></span>
                    </div>

                    <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 pt-2 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary order-2 order-sm-1">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-primary order-1 order-sm-2">
                            <i class="bi bi-check2-circle"></i> Create Record
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
