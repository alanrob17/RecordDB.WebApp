@model RecordDB.MVC.Models.RecordSearchViewModel

@{
    ViewData["Title"] = "Record Search";
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-10">

        <!-- Page Header -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
                <h1 class="h2 mb-1 fw-bold text-dark d-flex align-items-center gap-2">
                    <i class="bi bi-disc text-primary"></i>
                    Record Search
                </h1>
                <p class="text-muted mb-0 small">
                    Search for albums by entering a partial name. Click any record in the results to open its showcase page.
                </p>
            </div>
            <div>
                <a asp-controller="Record" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left"></i> Browse All Records
                </a>
            </div>
        </div>

        <!-- ======================================================================
             Search Input Form Card
             ====================================================================== -->
        <div class="app-card mb-4 shadow-sm">
            <div class="app-card-header colored-primary">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-search fs-5 text-white"></i>
                    <h2 class="h5 mb-0 fw-bold text-white">Filter by Record Name</h2>
                </div>
            </div>

            <div class="app-card-body">
                <form id="recordSearchForm" asp-action="Search" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="selectedRecordIdInput" name="SelectedRecordId" value="@(Model.SelectedRecordId?.ToString() ?? "")" />
                    <input type="hidden" id="actionTypeInput" name="actionType" value="search" />

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger border-0 d-flex align-items-center gap-2 mb-3" role="alert">
                            <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                            <div>
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <div>@error.ErrorMessage</div>
                                }
                            </div>
                        </div>
                    }

                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-8">
                            <label asp-for="RecordName" class="form-label fw-semibold">
                                <i class="bi bi-vinyl text-primary me-1"></i> Partial Album Name
                            </label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-white text-muted border-end-0">
                                    <i class="bi bi-search"></i>
                                </span>
                                <input asp-for="RecordName"
                                       id="recordSearchInput"
                                       class="form-control border-start-0"
                                       placeholder="e.g. Abbey, Dark, Moon, Greatest..."
                                       autocomplete="off"
                                       autofocus />
                                @if (!string.IsNullOrWhiteSpace(Model.RecordName))
                                {
                                    <a asp-action="Search" class="btn btn-outline-secondary border-start-0" title="Clear search">
                                        <i class="bi bi-x-lg"></i>
                                    </a>
                                }
                            </div>
                            <div class="form-text text-muted small">
                                Matches albums whose name contains this text (using <code>up_RecordSelectAll</code>).
                            </div>
                        </div>

                        <div class="col-12 col-md-4 d-flex gap-2">
                            <button type="submit" class="btn btn-primary btn-lg flex-fill">
                                <i class="bi bi-filter"></i> Search Records
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- ======================================================================
             Search Results / Filtered Record List
             ====================================================================== -->
        @if (Model.Searched)
        {
            if (!Model.HasResults)
            {
                <div class="app-card text-center py-5 px-3">
                    <div class="mb-3">
                        <i class="bi bi-disc text-muted" style="font-size: 3rem;"></i>
                    </div>
                    <h4 class="fw-semibold">No Records Found</h4>
                    <p class="text-muted mb-3">
                        No albums matched the search term <strong>"@Model.RecordName"</strong>.
                    </p>
                    <a asp-action="Search" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-clockwise"></i> Try Another Search
                    </a>
                </div>
            }
            else
            {
                <!-- Action Bar & Results Count -->
                <div class="app-card p-3 mb-3 bg-light border-0 shadow-sm d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill text-success fs-5"></i>
                        <div>
                            <span class="fw-bold text-dark">@Model.ResultCount</span>
                            <span class="text-muted">@(Model.ResultCount == 1 ? "record found" : "records found") matching</span>
                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25">"@Model.RecordName"</span>
                        </div>
                    </div>
                    <div class="text-muted small">
                        <i class="bi bi-cursor me-1"></i>Click any record to open <strong>RecordView</strong>.
                    </div>
                </div>

                <!-- ============================================================
                     Desktop & Tablet Table View (Visible >= md)
                     ============================================================ -->
                <div class="app-card d-none d-md-block mb-4 shadow-sm">
                    <div class="table-responsive">
                        <table class="table table-custom align-middle mb-0" id="recordsTable">
                            <thead>
                                <tr>
                                    <th style="width: 75px;">ID</th>
                                    <th>Album Title</th>
                                    <th>Artist</th>
                                    <th>Year</th>
                                    <th>Format</th>
                                    <th>Rating</th>
                                    <th class="text-end" style="width: 170px;">Showcase</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var record in Model.Results!)
                                {
                                    var recordViewUrl = Url.Action("RecordView", "Record", new { id = record.RecordId });

                                    <tr class="table-row-link record-row"
                                        style="cursor: pointer;"
                                        data-record-id="@record.RecordId"
                                        onclick="window.location='@recordViewUrl'"
                                        title="Click to view @record.Name in RecordView">
                                        <td>
                                            <span class="badge-id">#@record.RecordId</span>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="brand-icon" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                                    <i class="bi bi-vinyl"></i>
                                                </div>
                                                <span class="fw-semibold text-primary record-title">@record.Name</span>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="text-dark fw-medium">
                                                @(string.IsNullOrWhiteSpace(record.ArtistName) ? "—" : record.ArtistName)
                                            </span>
                                        </td>
                                        <td>
                                            @if (record.Recorded > 0)
                                            {
                                                <span class="badge bg-light text-dark border">@record.Recorded</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border small">
                                                @(string.IsNullOrWhiteSpace(record.Media) ? "CD" : record.Media)
                                                @if (record.Discs > 1)
                                                {
                                                    <span>(@record.Discs)</span>
                                                }
                                            </span>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(record.Rating))
                                            {
                                                <span class="badge bg-warning bg-opacity-10 text-dark border border-warning border-opacity-50">
                                                    ★ @record.Rating
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td class="text-end" onclick="event.stopPropagation()">
                                            <a asp-action="RecordView" asp-route-id="@record.RecordId"
                                               class="btn btn-sm btn-primary">
                                                <i class="bi bi-disc-fill me-1"></i> View Record
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- ============================================================
                     Mobile Cards View (Visible on Phone < md)
                     ============================================================ -->
                <div class="d-md-none mb-4" id="recordsMobileList">
                    <div class="row g-2">
                        @foreach (var record in Model.Results!)
                        {
                            var recordViewUrl = Url.Action("RecordView", "Record", new { id = record.RecordId });

                            <div class="col-12">
                                <div class="mobile-artist-card record-card p-3"
                                     style="cursor: pointer;"
                                     data-record-id="@record.RecordId"
                                     onclick="window.location='@recordViewUrl'"
                                     title="Tap to open @record.Name in RecordView">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="brand-icon" style="width: 34px; height: 34px; font-size: 0.9rem;">
                                                <i class="bi bi-vinyl"></i>
                                            </div>
                                            <div>
                                                <h3 class="artist-name mb-0 text-primary fw-bold">@record.Name</h3>
                                                <div class="artist-sub text-muted small">
                                                    @(string.IsNullOrWhiteSpace(record.ArtistName) ? "Unknown Artist" : record.ArtistName)
                                                </div>
                                            </div>
                                        </div>
                                        <span class="badge-id">#@record.RecordId</span>
                                    </div>

                                    <div class="d-flex flex-wrap gap-2 my-2 small">
                                        @if (record.Recorded > 0)
                                        {
                                            <span class="badge bg-light text-dark border">
                                                <i class="bi bi-calendar3"></i> @record.Recorded
                                            </span>
                                        }
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border">
                                            @(string.IsNullOrWhiteSpace(record.Media) ? "CD" : record.Media)
                                            @if (record.Discs > 1)
                                            {
                                                <span> • @record.Discs Discs</span>
                                            }
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(record.Rating))
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-dark border border-warning border-opacity-50">
                                                ★ @record.Rating
                                            </span>
                                        }
                                    </div>

                                    <div class="pt-2 border-top d-flex justify-content-between align-items-center" onclick="event.stopPropagation()">
                                        <span class="text-muted small">
                                            <i class="bi bi-tap me-1"></i>Tap to view
                                        </span>
                                        <a asp-action="RecordView" asp-route-id="@record.RecordId"
                                           class="btn btn-sm btn-primary">
                                            <i class="bi bi-disc-fill me-1"></i> View Record
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>
