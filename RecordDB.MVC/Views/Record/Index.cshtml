@model RecordDB.MVC.Models.PaginatedViewModel<RecordDB.Shared.DTOs.ArtistRecordDto>

@{
    var byArtistName = ViewBag.ByArtistName as string;
    var byArtistId   = ViewBag.ByArtistId   as int?;
    var isByArtist   = !string.IsNullOrWhiteSpace(byArtistName);
    ViewData["Title"] = isByArtist ? $"{byArtistName} — Albums" : "Records";
}

@* ── Artist-filter breadcrumb banner (only visible when coming from Artist Search) ── *@
@if (isByArtist)
{
    <div class="alert alert-primary border-0 shadow-sm d-flex align-items-center gap-3 mb-3 py-2 px-3" role="alert"
         style="background: linear-gradient(135deg, #eef2ff 0%, #f0f9ff 100%); border-left: 4px solid #4f46e5 !important;">
        <div class="d-flex align-items-center gap-2 flex-fill">
            <i class="bi bi-person-fill text-primary fs-5"></i>
            <div>
                <div class="fw-semibold text-dark">
                    Showing albums for <span class="text-primary">@byArtistName</span>
                </div>
                <div class="small text-muted">
                    @Model.TotalCount @(Model.TotalCount == 1 ? "album" : "albums") found &mdash;
                    @if (byArtistId.HasValue)
                    {
                        <a asp-controller="Artist" asp-action="Details" asp-route-id="@byArtistId"
                           class="text-primary text-decoration-none fw-medium">
                            <i class="bi bi-eye me-1"></i>View Artist Profile
                        </a>
                        <span class="mx-1 text-muted">|</span>
                    }
                    <a asp-controller="Artist" asp-action="Search" class="text-muted text-decoration-none">
                        <i class="bi bi-arrow-left me-1"></i>Back to Artist Search
                    </a>
                </div>
            </div>
        </div>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary flex-shrink-0">
            <i class="bi bi-x-lg"></i> Clear Filter
        </a>
    </div>
}

<!-- Page Header & Action Bar -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1 fw-bold text-dark d-flex align-items-center gap-2">
            <i class="bi bi-disc text-primary"></i>
            @if (isByArtist)
            {
                <span>@byArtistName</span>
            }
            else
            {
                <span>Records</span>
            }
            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill fs-6 fw-semibold">
                @Model.TotalCount @(Model.TotalCount == 1 ? "album" : "albums")
            </span>
        </h1>
        <p class="text-muted mb-0 small">
            @(isByArtist
                ? $"All albums by {byArtistName} in your collection."
                : "Browse, search, and manage albums, vinyls, CDs, and media in your collection.")
        </p>
    </div>

    <div class="d-flex flex-column flex-sm-row gap-2">
        <!-- Search form -->
        <form method="get" asp-action="Index" class="d-flex gap-1">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" name="search" value="@Model.SearchTerm" class="form-control border-start-0" 
                       placeholder="Search title, artist, label..." style="min-width: 190px;" />
                @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary border-start-0" title="Clear search">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
                <button type="submit" class="btn btn-primary">Search</button>
            </div>
        </form>

        <a asp-action="Create" class="btn btn-primary text-nowrap">
            <i class="bi bi-plus-circle-fill"></i> New Record
        </a>
    </div>
</div>

<!-- Success Banner -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-check-circle-fill fs-5 text-success"></i>
        <div>@TempData["Success"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Items.Any())
{
    <div class="app-card text-center py-5 px-3">
        <div class="mb-3">
            <i class="bi bi-disc text-muted" style="font-size: 3rem;"></i>
        </div>
        <h4 class="fw-semibold">No records found</h4>
        <p class="text-muted mb-3">
            @(string.IsNullOrWhiteSpace(Model.SearchTerm) 
                ? "Your album collection is currently empty." 
                : $"No records matched \"{Model.SearchTerm}\".")
        </p>
        <div>
            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
            {
                <a asp-action="Index" class="btn btn-outline-secondary me-2">
                    <i class="bi bi-arrow-left"></i> View All Records
                </a>
            }
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Add New Record
            </a>
        </div>
    </div>
}
else
{
    <!-- ======================================================================
         Desktop & Laptop View: Clean modern table (Visible on Large screens)
         ====================================================================== -->
    <div class="app-card d-none d-lg-block mb-4">
        <div class="table-responsive">
            <table class="table table-custom align-middle">
                <thead>
                    <tr>
                        <th style="width: 75px;">ID</th>
                        <th>Album Title</th>
                        <th>Artist</th>
                        <th>Year</th>
                        <th>Format</th>
                        <th>Label</th>
                        <th>Rating</th>
                        <th class="text-end" style="width: 250px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var record in Model.Items)
                    {
                        <tr>
                            <td>
                                <span class="badge-id">#@record.RecordId</span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="brand-icon" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                        <i class="bi bi-vinyl"></i>
                                    </div>
                                    <div class="fw-semibold text-dark">
                                        @record.Name
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (record.ArtistId > 0)
                                {
                                    <a asp-controller="Artist" asp-action="Details" asp-route-id="@record.ArtistId" 
                                       class="text-decoration-none fw-medium text-primary">
                                        @record.ArtistName
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (record.Recorded > 0)
                                {
                                    <span class="badge bg-light text-dark border">@record.Recorded</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-secondary bg-opacity-10 text-secondary border small">
                                    @(string.IsNullOrWhiteSpace(record.Media) ? "CD" : record.Media)
                                    @if (record.Discs > 1)
                                    {
                                        <span> • @record.Discs Discs</span>
                                    }
                                </span>
                            </td>
                            <td class="text-muted small">
                                @(string.IsNullOrWhiteSpace(record.Label) ? "—" : record.Label)
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(record.Rating))
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-dark border border-warning border-opacity-50">
                                        ★ @record.Rating
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@record.RecordId"
                                   class="btn btn-sm btn-outline-primary" title="View album details">
                                    <i class="bi bi-eye"></i> Details
                                </a>
                                <a asp-action="Edit" asp-route-id="@record.RecordId"
                                   class="btn btn-sm btn-success" title="Edit album">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@record.RecordId"
                                   class="btn btn-sm btn-danger" title="Delete album">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ======================================================================
         Tablet & Mobile View: Responsive Touch Cards (Visible on Mobile/Tablet)
         ====================================================================== -->
    <div class="d-lg-none mb-4">
        <div class="row g-3">
            @foreach (var record in Model.Items)
            {
                <div class="col-12 col-md-6">
                    <div class="mobile-artist-card">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <div class="brand-icon" style="width: 34px; height: 34px; font-size: 0.9rem;">
                                    <i class="bi bi-vinyl"></i>
                                </div>
                                <div>
                                    <h3 class="artist-name mb-0">@record.Name</h3>
                                    <div class="artist-sub">
                                        @record.ArtistName
                                    </div>
                                </div>
                            </div>
                            <span class="badge-id">#@record.RecordId</span>
                        </div>

                        <div class="d-flex flex-wrap gap-2 my-2 small">
                            @if (record.Recorded > 0)
                            {
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-calendar3"></i> @record.Recorded
                                </span>
                            }
                            <span class="badge bg-secondary bg-opacity-10 text-secondary border">
                                @(string.IsNullOrWhiteSpace(record.Media) ? "CD" : record.Media)
                                @if (record.Discs > 1)
                                {
                                    <span> • @record.Discs Discs</span>
                                }
                            </span>
                            @if (!string.IsNullOrWhiteSpace(record.Rating))
                            {
                                <span class="badge bg-warning bg-opacity-10 text-dark border border-warning border-opacity-50">
                                    ★ @record.Rating
                                </span>
                            }
                            @if (!string.IsNullOrWhiteSpace(record.Label))
                            {
                                <span class="text-muted">Label: @record.Label</span>
                            }
                        </div>

                        <div class="mobile-actions">
                            <a asp-action="Details" asp-route-id="@record.RecordId"
                               class="btn btn-outline-primary">
                                <i class="bi bi-eye"></i> Details
                            </a>
                            <a asp-action="Edit" asp-route-id="@record.RecordId"
                               class="btn btn-success">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@record.RecordId"
                               class="btn btn-danger">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- ======================================================================
         Responsive Pagination Section
         ====================================================================== -->
    @if (Model.TotalPages > 1)
    {
        <div class="app-card p-3 mb-4">
            <!-- Tablet & Desktop Pagination Bar (Full 15-button window) -->
            <div class="d-none d-md-flex align-items-center justify-content-between flex-wrap gap-3">
                <div class="text-muted small">
                    Showing <strong>@((Model.CurrentPage - 1) * Model.PageSize + 1)</strong> to 
                    <strong>@Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount)</strong> of 
                    <strong>@Model.TotalCount</strong> records
                </div>

                <nav aria-label="Record pagination desktop">
                    <ul class="pagination pagination-sm flex-wrap">
                        <!-- Single page Prev -->
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@Model.SearchTerm"
                               aria-label="Previous">
                                <i class="bi bi-chevron-left"></i> Prev
                            </a>
                        </li>

                        <!-- Previous Block of 15 -->
                        @if (Model.HasPreviousBlock)
                        {
                            <li class="page-item">
                                <a class="page-link"
                                   asp-action="Index" asp-route-page="@Model.PreviousBlockFirstPage" asp-route-search="@Model.SearchTerm"
                                   title="Go to pages @Model.PreviousBlockFirstPage – @(Model.PreviousBlockFirstPage + Model.BlockSize - 1)">
                                    &laquo; Prev 15
                                </a>
                            </li>
                            <li class="page-item disabled">
                                <span class="page-link">&hellip;</span>
                            </li>
                        }

                        <!-- Page number buttons (up to 15 in current block) -->
                        @for (int p = Model.BlockStart; p <= Model.BlockEnd; p++)
                        {
                            <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@Model.SearchTerm">@p</a>
                            </li>
                        }

                        <!-- Next Block of 15 -->
                        @if (Model.HasNextBlock)
                        {
                            <li class="page-item disabled">
                                <span class="page-link">&hellip;</span>
                            </li>
                            <li class="page-item">
                                <a class="page-link"
                                   asp-action="Index" asp-route-page="@Model.NextBlockFirstPage" asp-route-search="@Model.SearchTerm"
                                   title="Go to pages @Model.NextBlockFirstPage – @(Math.Min(Model.NextBlockFirstPage + Model.BlockSize - 1, Model.TotalPages))">
                                    Next 15 &raquo;
                                </a>
                            </li>
                        }

                        <!-- Single page Next -->
                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@Model.SearchTerm"
                               aria-label="Next">
                                Next <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>

            <!-- Mobile Compact Pagination Bar (Screen-friendly touch targets) -->
            <div class="d-md-none">
                <div class="mobile-pagination-bar mb-2">
                    <a class="btn btn-outline-secondary @(!Model.HasPreviousPage ? "disabled" : "")"
                       asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@Model.SearchTerm">
                        <i class="bi bi-chevron-left"></i> Prev
                    </a>
                    
                    <span class="badge bg-light text-dark border px-3 py-2 fs-6">
                        Page @Model.CurrentPage of @Model.TotalPages
                    </span>

                    <a class="btn btn-outline-secondary @(!Model.HasNextPage ? "disabled" : "")"
                       asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@Model.SearchTerm">
                        Next <i class="bi bi-chevron-right"></i>
                    </a>
                </div>

                @if (Model.TotalBlocks > 1)
                {
                    <div class="d-flex justify-content-between gap-2 mt-2 pt-2 border-top">
                        @if (Model.HasPreviousBlock)
                        {
                            <a class="btn btn-sm btn-outline-primary flex-fill"
                               asp-action="Index" asp-route-page="@Model.PreviousBlockFirstPage" asp-route-search="@Model.SearchTerm">
                                &laquo; Prev 15 Pages
                            </a>
                        }
                        @if (Model.HasNextBlock)
                        {
                            <a class="btn btn-sm btn-outline-primary flex-fill"
                               asp-action="Index" asp-route-page="@Model.NextBlockFirstPage" asp-route-search="@Model.SearchTerm">
                                Next 15 Pages &raquo;
                            </a>
                        }
                    </div>
                }

                <div class="text-center text-muted small mt-2">
                    Records @((Model.CurrentPage - 1) * Model.PageSize + 1) &ndash; @Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount) of @Model.TotalCount
                </div>
            </div>
        </div>
    }
}
