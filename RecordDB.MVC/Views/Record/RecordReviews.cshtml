@model RecordDB.MVC.Models.PaginatedViewModel<RecordDB.Shared.DTOs.ArtistRecordDto>

@{
    ViewData["Title"] = "Record Reviews";
}

<!-- Page Header & Action Bar -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1 fw-bold text-dark d-flex align-items-center gap-2">
            <i class="bi bi-chat-square-quote text-primary"></i> Record Reviews
            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill fs-6 fw-semibold">
                @Model.TotalCount @(Model.TotalCount == 1 ? "record" : "records")
            </span>
        </h1>
        <p class="text-muted mb-0 small">
            Browse album reviews across your entire music catalogue, or add reviews for records that don't have one.
        </p>
    </div>

    <div class="d-flex flex-column flex-sm-row gap-2">
        <!-- Search form -->
        <form method="get" asp-action="RecordReviews" class="d-flex gap-1">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" name="search" value="@Model.SearchTerm" class="form-control border-start-0" 
                       placeholder="Search artist, album, or review..." style="min-width: 240px;" />
                @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                {
                    <a asp-action="RecordReviews" class="btn btn-outline-secondary border-start-0" title="Clear search">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
                <button type="submit" class="btn btn-primary">Search</button>
            </div>
        </form>

        <a asp-action="Index" class="btn btn-outline-secondary text-nowrap">
            <i class="bi bi-collection"></i> All Records
        </a>
    </div>
</div>

<!-- Success Banner -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-check-circle-fill fs-5 text-success"></i>
        <div>@TempData["Success"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Items.Any())
{
    <div class="app-card text-center py-5 px-3">
        <div class="mb-3">
            <i class="bi bi-chat-square-quote text-muted" style="font-size: 3rem;"></i>
        </div>
        <h4 class="fw-semibold">No records found</h4>
        <p class="text-muted mb-3">
            @(string.IsNullOrWhiteSpace(Model.SearchTerm) 
                ? "There are currently no records in the catalogue." 
                : $"No records matched \"{Model.SearchTerm}\".")
        </p>
        <div>
            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
            {
                <a asp-action="RecordReviews" class="btn btn-outline-secondary me-2">
                    <i class="bi bi-arrow-left"></i> View All Reviews
                </a>
            }
            <a asp-action="Index" class="btn btn-primary">
                <i class="bi bi-collection"></i> Browse Records
            </a>
        </div>
    </div>
}
else
{
    <!-- ======================================================================
         Desktop & Laptop View: Clean modern table (Visible on Large screens)
         ====================================================================== -->
    <div class="app-card d-none d-lg-block mb-4">
        <div class="table-responsive">
            <table class="table table-custom align-middle">
                <thead>
                    <tr>
                        <th style="width: 22%;">Artist</th>
                        <th style="width: 24%;">Record</th>
                        <th style="width: 40%;">Review</th>
                        <th class="text-end" style="width: 14%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var record in Model.Items)
                    {
                        var hasReview = !string.IsNullOrWhiteSpace(record.Review);

                        <tr>
                            <td>
                                @if (record.ArtistId > 0)
                                {
                                    <a asp-controller="Artist" asp-action="Details" asp-route-id="@record.ArtistId" 
                                       class="text-decoration-none fw-medium text-primary">
                                        @record.Artist.Name
                                    </a>
                                }
                                else
                                {
                                    <span class="fw-medium text-dark">@(string.IsNullOrWhiteSpace(record.Artist.Name) ? "—" : record.Artist.Name)</span>
                                }
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">
                                    <a asp-action="Details" asp-route-id="@record.RecordId" class="text-dark text-decoration-none">
                                        @record.Name
                                    </a>
                                </div>
                            </td>
                            <td>
                                @if (hasReview)
                                {
                                    var cleanReview = System.Text.RegularExpressions.Regex.Replace(record.Review ?? string.Empty, "<.*?>", string.Empty).Trim();
                                    <div class="text-muted small" title="@cleanReview">
                                        @(cleanReview.Length > 180 ? cleanReview[..180] + "…" : cleanReview)
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-warning bg-opacity-10 text-dark border border-warning border-opacity-50 small">
                                            <i class="bi bi-exclamation-circle me-1"></i>No Review
                                        </span>
                                    </div>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                @if (!hasReview)
                                {
                                    <a asp-action="Edit" asp-route-id="@record.RecordId"
                                       class="btn btn-sm btn-primary" title="Add review">
                                        <i class="bi bi-pencil-square"></i> Add Review
                                    </a>
                                }
                                else
                                {
                                    <a asp-action="Edit" asp-route-id="@record.RecordId"
                                       class="btn btn-sm btn-outline-success" title="Edit review">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ======================================================================
         Tablet & Mobile View: Responsive Touch Cards (Visible on Mobile/Tablet)
         ====================================================================== -->
    <div class="d-lg-none mb-4">
        <div class="row g-3">
            @foreach (var record in Model.Items)
            {
                var hasReview = !string.IsNullOrWhiteSpace(record.Review);

                <div class="col-12 col-md-6">
                    <div class="mobile-artist-card">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <div class="brand-icon" style="width: 34px; height: 34px; font-size: 0.9rem;">
                                    <i class="bi bi-disc"></i>
                                </div>
                                <div>
                                    <h3 class="artist-name mb-0">@record.Name</h3>
                                    <div class="artist-sub">
                                        @record.Artist.Name
                                    </div>
                                </div>
                            </div>
                            <span class="badge-id">#@record.RecordId</span>
                        </div>

                        <div class="artist-bio mb-3">
                            @if (hasReview)
                            {
                                var cleanReview = System.Text.RegularExpressions.Regex.Replace(record.Review ?? string.Empty, "<.*?>", string.Empty).Trim();
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 small mb-1">
                                    <i class="bi bi-check-circle me-1"></i>Review Available
                                </span>
                                <div class="text-muted small mt-1">
                                    @(cleanReview.Length > 120 ? cleanReview[..120] + "…" : cleanReview)
                                </div>
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-between gap-2">
                                    <span class="badge bg-warning bg-opacity-10 text-dark border border-warning border-opacity-50 small">
                                        <i class="bi bi-exclamation-triangle me-1"></i>No review provided
                                    </span>
                                </div>
                            }
                        </div>

                        <div class="mobile-actions">
                            @if (!hasReview)
                            {
                                <a asp-action="Edit" asp-route-id="@record.RecordId"
                                   class="btn btn-primary flex-fill">
                                    <i class="bi bi-pencil-square"></i> Add Review
                                </a>
                            }
                            else
                            {
                                <a asp-action="Edit" asp-route-id="@record.RecordId"
                                   class="btn btn-outline-success flex-fill">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                            }
                            <a asp-action="Details" asp-route-id="@record.RecordId"
                               class="btn btn-outline-primary">
                                <i class="bi bi-eye"></i> Details
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- ======================================================================
         Responsive Pagination Section (Identical to Views/Record/Index.cshtml)
         ====================================================================== -->
    @if (Model.TotalPages > 1)
    {
        <div class="app-card p-3 mb-4">
            <!-- Tablet & Desktop Pagination Bar (Full 15-button window) -->
            <div class="d-none d-md-flex align-items-center justify-content-between flex-wrap gap-3">
                <div class="text-muted small">
                    Showing <strong>@((Model.CurrentPage - 1) * Model.PageSize + 1)</strong> to 
                    <strong>@Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount)</strong> of 
                    <strong>@Model.TotalCount</strong> records
                </div>

                <nav aria-label="Record reviews pagination desktop">
                    <ul class="pagination pagination-sm flex-wrap">
                        <!-- Single page Prev -->
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="RecordReviews" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@Model.SearchTerm"
                               aria-label="Previous">
                                <i class="bi bi-chevron-left"></i> Prev
                            </a>
                        </li>

                        <!-- Previous Block of 15 -->
                        @if (Model.HasPreviousBlock)
                        {
                            <li class="page-item">
                                <a class="page-link"
                                   asp-action="RecordReviews" asp-route-page="@Model.PreviousBlockFirstPage" asp-route-search="@Model.SearchTerm"
                                   title="Go to pages @Model.PreviousBlockFirstPage – @(Model.PreviousBlockFirstPage + Model.BlockSize - 1)">
                                    &laquo; Prev 15
                                </a>
                            </li>
                            <li class="page-item disabled">
                                <span class="page-link">&hellip;</span>
                            </li>
                        }

                        <!-- Page number buttons (up to 15 in current block) -->
                        @for (int p = Model.BlockStart; p <= Model.BlockEnd; p++)
                        {
                            <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="RecordReviews" asp-route-page="@p" asp-route-search="@Model.SearchTerm">@p</a>
                            </li>
                        }

                        <!-- Next Block of 15 -->
                        @if (Model.HasNextBlock)
                        {
                            <li class="page-item disabled">
                                <span class="page-link">&hellip;</span>
                            </li>
                            <li class="page-item">
                                <a class="page-link"
                                   asp-action="RecordReviews" asp-route-page="@Model.NextBlockFirstPage" asp-route-search="@Model.SearchTerm"
                                   title="Go to pages @Model.NextBlockFirstPage – @(Math.Min(Model.NextBlockFirstPage + Model.BlockSize - 1, Model.TotalPages))">
                                    Next 15 &raquo;
                                </a>
                            </li>
                        }

                        <!-- Single page Next -->
                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="RecordReviews" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@Model.SearchTerm"
                               aria-label="Next">
                                Next <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>

            <!-- Mobile Compact Pagination Bar (Screen-friendly touch targets) -->
            <div class="d-md-none">
                <div class="mobile-pagination-bar mb-2">
                    <a class="btn btn-outline-secondary @(!Model.HasPreviousPage ? "disabled" : "")"
                       asp-action="RecordReviews" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@Model.SearchTerm">
                        <i class="bi bi-chevron-left"></i> Prev
                    </a>
                    
                    <span class="badge bg-light text-dark border px-3 py-2 fs-6">
                        Page @Model.CurrentPage of @Model.TotalPages
                    </span>

                    <a class="btn btn-outline-secondary @(!Model.HasNextPage ? "disabled" : "")"
                       asp-action="RecordReviews" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@Model.SearchTerm">
                        Next <i class="bi bi-chevron-right"></i>
                    </a>
                </div>

                @if (Model.TotalBlocks > 1)
                {
                    <div class="d-flex justify-content-between gap-2 mt-2 pt-2 border-top">
                        @if (Model.HasPreviousBlock)
                        {
                            <a class="btn btn-sm btn-outline-primary flex-fill"
                               asp-action="RecordReviews" asp-route-page="@Model.PreviousBlockFirstPage" asp-route-search="@Model.SearchTerm">
                                &laquo; Prev 15 Pages
                            </a>
                        }
                        @if (Model.HasNextBlock)
                        {
                            <a class="btn btn-sm btn-outline-primary flex-fill"
                               asp-action="RecordReviews" asp-route-page="@Model.NextBlockFirstPage" asp-route-search="@Model.SearchTerm">
                                Next 15 Pages &raquo;
                            </a>
                        }
                    </div>
                }

                <div class="text-center text-muted small mt-2">
                    Records @((Model.CurrentPage - 1) * Model.PageSize + 1) &ndash; @Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount) of @Model.TotalCount
                </div>
            </div>
        </div>
    }
}
