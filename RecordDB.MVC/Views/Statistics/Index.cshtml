@model RecordDB.Shared.DTOs.StatisticDto

@{
    ViewData["Title"] = "Statistics";
}

<!-- Page Header (Centered) -->
<div class="text-center mb-4">
    <h1 class="h2 fw-bold text-dark d-inline-flex align-items-center gap-2 mb-1">
        <i class="bi bi-bar-chart-fill text-primary"></i> Statistics
    </h1>
    <p class="text-muted small mb-0">Overview of media, purchase history, genres, and ratings.</p>
</div>

<!-- Centered Container for Responsive Layout -->
<div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-9 col-xl-8">

        <!-- Top KPI Quick-Glance Cards (Phone: 1 col, Tablet/PC: 3 cols) -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-4">
                <div class="stats-summary-card">
                    <div class="stats-summary-icon bg-primary bg-opacity-10 text-primary mx-auto">
                        <i class="bi bi-disc-fill"></i>
                    </div>
                    <div class="text-muted small fw-medium text-uppercase">Total CDs</div>
                    <div class="fs-4 fw-bold text-dark my-1">@Model.TotalCDs.ToString("N0")</div>
                    <div class="small text-muted">Total: <span class="fw-semibold text-primary">@Model.CDCost.ToString("c")</span></div>
                </div>
            </div>
            <div class="col-12 col-sm-4">
                <div class="stats-summary-card">
                    <div class="stats-summary-icon bg-info bg-opacity-10 text-info mx-auto">
                        <i class="bi bi-vinyl-fill"></i>
                    </div>
                    <div class="text-muted small fw-medium text-uppercase">Total Vinyl Records</div>
                    <div class="fs-4 fw-bold text-dark my-1">@Model.TotalRecords.ToString("N0")</div>
                    <div class="small text-muted">Total: <span class="fw-semibold text-info">@Model.RecordCost.ToString("c")</span></div>
                </div>
            </div>
            <div class="col-12 col-sm-4">
                <div class="stats-summary-card">
                    <div class="stats-summary-icon bg-success bg-opacity-10 text-success mx-auto">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                    <div class="text-muted small fw-medium text-uppercase">Total Invested</div>
                    <div class="fs-4 fw-bold text-success my-1">@Model.TotalCost.ToString("c")</div>
                    <div class="small text-muted">Avg / CD: <span class="fw-semibold text-dark">@Model.AvCDCost.ToString("c")</span></div>
                </div>
            </div>
        </div>

        <!-- Main Statistics Card with Centered Table -->
        <div class="app-card mb-4">
            <div class="app-card-header d-flex align-items-center justify-content-between">
                <span class="fw-bold d-flex align-items-center gap-2">
                    <i class="bi bi-table text-primary"></i> Detailed Breakdown
                </span>
                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-3 py-1 small">
                    Catalogue Metrics
                </span>
            </div>

            <div class="table-responsive">
                <table class="table stats-table mb-0">
                    <thead>
                        <tr>
                            <th class="ps-3 ps-sm-4">Metric</th>
                            <th class="text-end pe-3 ps-sm-4">Value</th>
                        </tr>
                    </thead>
                    <tbody>

                        <!-- ── 1. Annual Purchases (2017 - 2022) ── -->
                        <tr class="stats-table-section-header">
                            <th colspan="2" class="ps-3 ps-sm-4">
                                <i class="bi bi-calendar3 me-2 text-primary"></i> Annual Purchases (2017 – 2022)
                            </th>
                        </tr>

                        <!-- 2022 -->
                        <tr>
                            <td class="ps-3 ps-sm-4"><i class="bi bi-disc me-2 text-muted"></i>Number of Discs bought in <strong>2022</strong></td>
                            <td class="text-end pe-3 pe-sm-4"><span class="stats-value-badge">@Model.Disks2022</span></td>
                        </tr>
                        <tr>
                            <td class="ps-3 ps-sm-4 text-muted ps-4">Total Amount spent in 2022</td>
                            <td class="text-end pe-3 pe-sm-4 fw-semibold">@Model.Cost2022.ToString("c")</td>
                        </tr>
                        <tr class="stats-sub-divider">
                            <td class="ps-3 ps-sm-4 text-muted ps-4">Average cost per Disc in 2022</td>
                            <td class="text-end pe-3 pe-sm-4 text-muted">@Model.Av2022.ToString("c")</td>
                        </tr>

                        <!-- 2021 -->
                        <tr>
                            <td class="ps-3 ps-sm-4"><i class="bi bi-disc me-2 text-muted"></i>Number of Discs bought in <strong>2021</strong></td>
                            <td class="text-end pe-3 pe-sm-4"><span class="stats-value-badge">@Model.Disks2021</span></td>
                        </tr>
                        <tr>
                            <td class="ps-3 ps-sm-4 text-muted ps-4">Total Amount spent in 2021</td>
                            <td class="text-end pe-3 pe-sm-4 fw-semibold">@Model.Cost2021.ToString("c")</td>
                        </tr>
                        <tr class="stats-sub-divider">
                            <td class="ps-3 ps-sm-4 text-muted ps-4">Average cost per Disc in 2021</td>
                            <td class="text-end pe-3 pe-sm-4 text-muted">@Model.Av2021.ToString("c")</td>
                        </tr>

                        <!-- 2020 -->
                        <tr>
                            <td class="ps-3 ps-sm-4"><i class="bi bi-disc me-2 text-muted"></i>Number of Discs bought in <strong>2020</strong></td>
                            <td class="text-end pe-3 pe-sm-4"><span class="stats-value-badge">@Model.Disks2020</span></td>
                        </tr>
                        <tr>
                            <td class="ps-3 ps-sm-4 text-muted ps-4">Total Amount spent in 2020</td>
                            <td class="text-end pe-3 pe-sm-4 fw-semibold">@Model.Cost2020.ToString("c")</td>
                        </tr>
                        <tr class="stats-sub-divider">
                            <td class="ps-3 ps-sm-4 text-muted ps-4">Average cost per Disc in 2020</td>
                            <td class="text-end pe-3 pe-sm-4 text-muted">@Model.Av2020.ToString("c")</td>
                        </tr>

                        <!-- 2019 -->
                        <tr>
                            <td class="ps-3 ps-sm-4"><i class="bi bi-disc me-2 text-muted"></i>Number of Discs bought in <strong>2019</strong></td>
                            <td class="text-end pe-3 pe-sm-4"><span class="stats-value-badge">@Model.Disks2019</span></td>
                        </tr>
                        <tr>
                            <td class="ps-3 ps-sm-4 text-muted ps-4">Total Amount spent in 2019</td>
                            <td class="text-end pe-3 pe-sm-4 fw-semibold">@Model.Cost2019.ToString("c")</td>
                        </tr>
                        <tr class="stats-sub-divider">
                            <td class="ps-3 ps-sm-4 text-muted ps-4">Average cost per Disc in 2019</td>
                            <td class="text-end pe-3 pe-sm-4 text-muted">@Model.Av2019.ToString("c")</td>
                        </tr>

                        <!-- 2018 -->
                        <tr>
                            <td class="ps-3 ps-sm-4"><i class="bi bi-disc me-2 text-muted"></i>Number of Discs bought in <strong>2018</strong></td>
                            <td class="text-end pe-3 pe-sm-4"><span class="stats-value-badge">@Model.Disks2018</span></td>
                        </tr>
                        <tr>
                            <td class="ps-3 ps-sm-4 text-muted ps-4">Total Amount spent in 2018</td>
                            <td class="text-end pe-3 pe-sm-4 fw-semibold">@Model.Cost2018.ToString("c")</td>
                        </tr>
                        <tr class="stats-sub-divider">
                            <td class="ps-3 ps-sm-4 text-muted ps-4">Average cost per Disc in 2018</td>
                            <td class="text-end pe-3 pe-sm-4 text-muted">@Model.Av2018.ToString("c")</td>
                        </tr>

                        <!-- 2017 -->
                        <tr>
                            <td class="ps-3 ps-sm-4"><i class="bi bi-disc me-2 text-muted"></i>Number of Discs bought in <strong>2017</strong></td>
                            <td class="text-end pe-3 pe-sm-4"><span class="stats-value-badge">@Model.Disks2017</span></td>
                        </tr>
                        <tr>
                            <td class="ps-3 ps-sm-4 text-muted ps-4">Total Amount spent in 2017</td>
                            <td class="text-end pe-3 pe-sm-4 fw-semibold">@Model.Cost2017.ToString("c")</td>
                        </tr>
                        <tr class="stats-sub-divider">
                            <td class="ps-3 ps-sm-4 text-muted ps-4">Average cost per Disc in 2017</td>
                            <td class="text-end pe-3 pe-sm-4 text-muted">@Model.Av2017.ToString("c")</td>
                        </tr>

                        <!-- ── 2. Media & Spending Totals ── -->
                        <tr class="stats-table-section-header">
                            <th colspan="2" class="ps-3 ps-sm-4">
                                <i class="bi bi-wallet2 me-2 text-primary"></i> Media & Spending Totals
                            </th>
                        </tr>
                        <tr>
                            <td class="ps-3 ps-sm-4"><i class="bi bi-disc-fill me-2 text-primary"></i>Total Number of Compact Discs (CDs)</td>
                            <td class="text-end pe-3 pe-sm-4 fw-bold">@Model.TotalCDs.ToString("N0")</td>
                        </tr>
                        <tr>
                            <td class="ps-3 ps-sm-4 text-muted ps-4">Total Amount spent on CDs</td>
                            <td class="text-end pe-3 pe-sm-4 fw-semibold">@Model.CDCost.ToString("c")</td>
                        </tr>
                        <tr class="stats-sub-divider">
                            <td class="ps-3 ps-sm-4 text-muted ps-4">Average spent per CD</td>
                            <td class="text-end pe-3 pe-sm-4 text-muted">@Model.AvCDCost.ToString("c")</td>
                        </tr>
                        <tr>
                            <td class="ps-3 ps-sm-4"><i class="bi bi-vinyl-fill me-2 text-info"></i>Total Number of Vinyl Records</td>
                            <td class="text-end pe-3 pe-sm-4 fw-bold">@Model.TotalRecords.ToString("N0")</td>
                        </tr>
                        <tr class="stats-sub-divider">
                            <td class="ps-3 ps-sm-4 text-muted ps-4">Amount spent on Vinyl Records</td>
                            <td class="text-end pe-3 pe-sm-4 fw-semibold">@Model.RecordCost.ToString("c")</td>
                        </tr>
                        <tr class="bg-light bg-opacity-75">
                            <td class="ps-3 ps-sm-4"><strong class="text-dark"><i class="bi bi-cash-coin me-2 text-success"></i>Total Amount Spent (All Media)</strong></td>
                            <td class="text-end pe-3 pe-sm-4"><span class="fs-6 fw-bold text-success">@Model.TotalCost.ToString("c")</span></td>
                        </tr>

                        <!-- ── 3. Discs by Genre ── -->
                        <tr class="stats-table-section-header">
                            <th colspan="2" class="ps-3 ps-sm-4">
                                <i class="bi bi-music-note-beamed me-2 text-primary"></i> Discs by Genre
                            </th>
                        </tr>
                        <tr>
                            <td class="ps-3 ps-sm-4"><i class="bi bi-lightning-charge me-2 text-danger"></i>Rock</td>
                            <td class="text-end pe-3 pe-sm-4"><span class="stats-value-badge">@Model.RockDisks.ToString("N0")</span></td>
                        </tr>
                        <tr>
                            <td class="ps-3 ps-sm-4"><i class="bi bi-tree me-2 text-success"></i>Folk</td>
                            <td class="text-end pe-3 pe-sm-4"><span class="stats-value-badge">@Model.FolkDisks.ToString("N0")</span></td>
                        </tr>
                        <tr>
                            <td class="ps-3 ps-sm-4"><i class="bi bi-soundwave me-2 text-info"></i>Acoustic</td>
                            <td class="text-end pe-3 pe-sm-4"><span class="stats-value-badge">@Model.AcousticDisks.ToString("N0")</span></td>
                        </tr>
                        <tr>
                            <td class="ps-3 ps-sm-4"><i class="bi bi-boombox me-2 text-primary"></i>Jazz & Fusion</td>
                            <td class="text-end pe-3 pe-sm-4"><span class="stats-value-badge">@Model.JazzDisks.ToString("N0")</span></td>
                        </tr>
                        <tr>
                            <td class="ps-3 ps-sm-4"><i class="bi bi-vinyl me-2 text-secondary"></i>Blues</td>
                            <td class="text-end pe-3 pe-sm-4"><span class="stats-value-badge">@Model.BluesDisks.ToString("N0")</span></td>
                        </tr>
                        <tr>
                            <td class="ps-3 ps-sm-4"><i class="bi bi-geo-alt me-2 text-warning"></i>Country</td>
                            <td class="text-end pe-3 pe-sm-4"><span class="stats-value-badge">@Model.CountryDisks.ToString("N0")</span></td>
                        </tr>
                        <tr>
                            <td class="ps-3 ps-sm-4"><i class="bi bi-music-note me-2 text-indigo" style="color: #6366f1;"></i>Classical</td>
                            <td class="text-end pe-3 pe-sm-4"><span class="stats-value-badge">@Model.ClassicalDisks.ToString("N0")</span></td>
                        </tr>
                        <tr>
                            <td class="ps-3 ps-sm-4"><i class="bi bi-film me-2 text-dark"></i>Soundtrack</td>
                            <td class="text-end pe-3 pe-sm-4"><span class="stats-value-badge">@Model.SoundtrackDisks.ToString("N0")</span></td>
                        </tr>

                        <!-- ── 4. Album Ratings ── -->
                        <tr class="stats-table-section-header">
                            <th colspan="2" class="ps-3 ps-sm-4">
                                <i class="bi bi-star-fill me-2 text-warning"></i> Album Ratings Distribution
                            </th>
                        </tr>
                        <tr>
                            <td class="ps-3 ps-sm-4">
                                <span class="text-warning me-1">
                                    <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                                </span>
                                <strong>Indispensable</strong> (4-Star)
                            </td>
                            <td class="text-end pe-3 pe-sm-4"><span class="stats-value-badge">@Model.FourStarDisks.ToString("N0")</span></td>
                        </tr>
                        <tr>
                            <td class="ps-3 ps-sm-4">
                                <span class="text-warning me-1">
                                    <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                                </span>
                                <strong>Slightly Flawed</strong> (3-Star)
                            </td>
                            <td class="text-end pe-3 pe-sm-4"><span class="stats-value-badge">@Model.ThreeStarDisks.ToString("N0")</span></td>
                        </tr>
                        <tr>
                            <td class="ps-3 ps-sm-4">
                                <span class="text-warning me-1">
                                    <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                                </span>
                                <strong>Average</strong> (2-Star)
                            </td>
                            <td class="text-end pe-3 pe-sm-4"><span class="stats-value-badge">@Model.TwoStarDisks.ToString("N0")</span></td>
                        </tr>
                        <tr>
                            <td class="ps-3 ps-sm-4">
                                <span class="text-warning me-1">
                                    <i class="bi bi-star-fill"></i>
                                </span>
                                <strong>Mediocre</strong> (1-Star)
                            </td>
                            <td class="text-end pe-3 pe-sm-4"><span class="stats-value-badge">@Model.OneStarDisks.ToString("N0")</span></td>
                        </tr>

                    </tbody>
                </table>
            </div>

            <div class="app-card-footer text-center text-muted small py-2">
                <i class="bi bi-info-circle me-1"></i> Data aggregates automatically calculated from the RecordDB database.
            </div>
        </div>

    </div>
</div>
