@model RecordDB.Shared.DTOs.CreateDiscDto

@{
    ViewData["Title"] = "New Disc";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-9 col-lg-7">
        <div class="mb-3">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> Back to Discs
            </a>
        </div>

        <div class="app-card">
            <div class="app-card-header colored-primary">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-vinyl-fill fs-4 text-white"></i>
                    <div>
                        <h1 class="h4 mb-0 fw-bold text-white">Add New Disc</h1>
                        <span class="text-white-50 small">Attach a disc to an album in your collection</span>
                    </div>
                </div>
            </div>

            <div class="app-card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger d-flex align-items-center gap-2 mb-3" role="alert">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <div>Please check the errors below.</div>
                    </div>

                    <!-- Album Selection -->
                    <div class="mb-3">
                        <label asp-for="RecordId" class="form-label">Album <span class="text-danger">*</span></label>
                        <select asp-for="RecordId" asp-items="ViewBag.Records" class="form-select">
                            <option value="">-- Select an Album --</option>
                        </select>
                        <span asp-validation-for="RecordId" class="text-danger small"></span>
                        <div class="form-text text-muted small">Listed as Artist – Album Title.</div>
                    </div>

                    <!-- Disc Number -->
                    <div class="mb-3">
                        <label asp-for="DiscNo" class="form-label">Disc Number <span class="text-danger">*</span></label>
                        <input asp-for="DiscNo" type="number" min="1" class="form-control" placeholder="e.g. 1" />
                        <span asp-validation-for="DiscNo" class="text-danger small"></span>
                        <div class="form-text text-muted small">Use 1 for a single-disc album, 2 for the second disc of a multi-disc set, etc.</div>
                    </div>

                    <!-- Length -->
                    <div class="mb-3">
                        <label asp-for="Length" class="form-label">Length <span class="text-muted fw-normal">(optional, in seconds)</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-clock"></i></span>
                            <input asp-for="Length" type="number" min="0" class="form-control" placeholder="e.g. 2684" />
                            <span class="input-group-text bg-light text-muted">s</span>
                        </div>
                        <span asp-validation-for="Length" class="text-danger small"></span>
                        <div class="form-text text-muted small">Total playing time in seconds. Leave blank if unknown.</div>
                    </div>

                    <!-- FreeDb fields -->
                    <div class="card bg-light border rounded-3 p-3 mb-4">
                        <h6 class="fw-semibold text-muted mb-3"><i class="bi bi-database me-1"></i> FreeDb Metadata <span class="badge bg-secondary fw-normal">Optional</span></h6>
                        <div class="row g-3">
                            <div class="col-12 col-sm-6">
                                <label asp-for="FreeDbDiscId" class="form-label">FreeDb Disc ID</label>
                                <input asp-for="FreeDbDiscId" type="number" class="form-control" placeholder="e.g. 12345678" />
                                <span asp-validation-for="FreeDbDiscId" class="text-danger small"></span>
                            </div>
                            <div class="col-12 col-sm-6">
                                <label asp-for="FreeDbId" class="form-label">FreeDb ID</label>
                                <input asp-for="FreeDbId" class="form-control" placeholder="e.g. a30d8f0b" />
                                <span asp-validation-for="FreeDbId" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 pt-2 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary order-2 order-sm-1">Cancel</a>
                        <button type="submit" class="btn btn-primary order-1 order-sm-2">
                            <i class="bi bi-check2-circle"></i> Create Disc
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
