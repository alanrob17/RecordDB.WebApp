@model RecordDB.Shared.DTOs.UpdateDiscDto

@{
    ViewData["Title"] = $"Edit Disc {Model.DiscNo}";
    var recordName = ViewBag.RecordName as string;
    var artistName = ViewBag.ArtistName as string;
}

<div class="row justify-content-center">
    <div class="col-12 col-md-9 col-lg-7">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> Back to Discs
            </a>
            <span class="badge-id">Editing Disc #@Model.DiscId</span>
        </div>

        <div class="app-card">
            <div class="app-card-header colored-primary">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-pencil-square fs-4 text-white"></i>
                    <div>
                        <h1 class="h4 mb-0 fw-bold text-white">Edit Disc</h1>
                        <span class="text-white-50 small">
                            Disc @Model.DiscNo
                            @if (!string.IsNullOrWhiteSpace(recordName))
                            {
                                <span> &mdash; @artistName – @recordName</span>
                            }
                        </span>
                    </div>
                </div>
            </div>

            <div class="app-card-body">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger d-flex align-items-center gap-2 mb-3" role="alert">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <div>Please check the errors below.</div>
                    </div>

                    <input type="hidden" asp-for="DiscId" />

                    <!-- Album Selection (read context — disc to record link is set on create) -->
                    <div class="mb-3">
                        <label class="form-label text-muted fw-semibold">Album</label>
                        <div class="p-2 bg-light border rounded-3 d-flex align-items-center gap-2 text-dark">
                            <i class="bi bi-disc text-primary"></i>
                            <span>@(artistName ?? "—") – @(recordName ?? "—")</span>
                        </div>
                        <div class="form-text small text-muted">The album this disc belongs to cannot be changed here. Delete and re-create the disc to move it.</div>
                    </div>

                    <!-- Disc Number -->
                    <div class="mb-3">
                        <label asp-for="DiscNo" class="form-label">Disc Number <span class="text-danger">*</span></label>
                        <input asp-for="DiscNo" type="number" min="1" class="form-control" />
                        <span asp-validation-for="DiscNo" class="text-danger small"></span>
                    </div>

                    <!-- Length -->
                    <div class="mb-3">
                        <label asp-for="Length" class="form-label">Length <span class="text-muted fw-normal">(in seconds)</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-clock"></i></span>
                            <input asp-for="Length" type="number" min="0" class="form-control" placeholder="Leave blank to clear" />
                            <span class="input-group-text bg-light text-muted">s</span>
                        </div>
                        <span asp-validation-for="Length" class="text-danger small"></span>
                    </div>

                    <!-- FreeDb fields -->
                    <div class="card bg-light border rounded-3 p-3 mb-4">
                        <h6 class="fw-semibold text-muted mb-3"><i class="bi bi-database me-1"></i> FreeDb Metadata <span class="badge bg-secondary fw-normal">Optional</span></h6>
                        <div class="row g-3">
                            <div class="col-12 col-sm-6">
                                <label asp-for="FreeDbDiscId" class="form-label">FreeDb Disc ID</label>
                                <input asp-for="FreeDbDiscId" type="number" class="form-control" />
                                <span asp-validation-for="FreeDbDiscId" class="text-danger small"></span>
                            </div>
                            <div class="col-12 col-sm-6">
                                <label asp-for="FreeDbId" class="form-label">FreeDb ID</label>
                                <input asp-for="FreeDbId" class="form-control" />
                                <span asp-validation-for="FreeDbId" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex flex-column flex-sm-row justify-content-between gap-2 pt-2 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary order-3 order-sm-1">Cancel</a>
                        <div class="d-flex gap-2 order-1 order-sm-2">
                            <a asp-action="Details" asp-route-id="@Model.DiscId" class="btn btn-outline-primary flex-fill">
                                <i class="bi bi-eye"></i> Details
                            </a>
                            <button type="submit" class="btn btn-success flex-fill">
                                <i class="bi bi-check2"></i> Save Changes
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
