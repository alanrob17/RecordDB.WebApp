@model RecordDB.MVC.Models.PaginatedViewModel<RecordDB.Shared.DTOs.ArtistRecordDiscDto>
@using System.Linq

@{
    ViewData["Title"] = "Discs";
    var formatLength = ViewBag.FormatLength as Func<int?, string> ?? (_ => "—");
}

<!-- Page Header & Action Bar -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1 fw-bold text-dark d-flex align-items-center gap-2">
            <i class="bi bi-vinyl-fill text-primary"></i> Discs
            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill fs-6 fw-semibold">
                @Model.TotalCount @(Model.TotalCount == 1 ? "disc" : "discs")
            </span>
        </h1>
        <p class="text-muted mb-0 small">Browse and manage individual discs within your album collection.</p>
    </div>

    <div class="d-flex flex-column flex-sm-row gap-2">
        <!-- Search form: uses the API's by-record-name search -->
        <form method="get" asp-action="Index" class="d-flex gap-1">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" name="search" value="@Model.SearchTerm" class="form-control border-start-0"
                       placeholder="Search by album name..." style="min-width: 180px;" />
                @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary border-start-0" title="Clear search">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
                <button type="submit" class="btn btn-primary">Search</button>
            </div>
        </form>

        <a asp-action="Create" class="btn btn-primary text-nowrap">
            <i class="bi bi-plus-circle-fill"></i> New Disc
        </a>
    </div>
</div>

<!-- Success Banner -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-check-circle-fill fs-5 text-success"></i>
        <div>@TempData["Success"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Items.Any())
{
    <div class="app-card text-center py-5 px-3">
        <div class="mb-3">
            <i class="bi bi-vinyl text-muted" style="font-size: 3rem;"></i>
        </div>
        <h4 class="fw-semibold">No discs found</h4>
        <p class="text-muted mb-3">
            @(string.IsNullOrWhiteSpace(Model.SearchTerm)
                ? "Your disc library is currently empty."
                : $"No discs matched album name \"{Model.SearchTerm}\".")
        </p>
        <div>
            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
            {
                <a asp-action="Index" class="btn btn-outline-secondary me-2">
                    <i class="bi bi-arrow-left"></i> View All Discs
                </a>
            }
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Add New Disc
            </a>
        </div>
    </div>
}
else
{
    <!-- ======================================================================
         Desktop Table (lg+)
         ====================================================================== -->
    <div class="app-card d-none d-lg-block mb-4">
        <div class="table-responsive">
            <table class="table table-custom align-middle">
                <thead>
                    <tr>
                        <th style="width: 75px;">ID</th>
                        <th>Album</th>
                        <th>Artist</th>
                        <th style="width: 90px;">Disc No.</th>
                        <th style="width: 110px;">Length</th>
                        <th>FreeDb Disc ID</th>
                        <th>FreeDb ID</th>
                        <th class="text-end" style="width: 250px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var disc in Model.Items)
                    {
                        <tr>
                            <td><span class="badge-id">#@disc.DiscId</span></td>
                            <td>
                                <div class="fw-semibold text-dark">@disc.Name</div>
                            </td>
                            <td class="text-muted">@disc.ArtistName</td>
                            <td class="text-center">
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 fw-semibold">
                                    Disc @disc.DiscNo
                                </span>
                            </td>
                            <td>
                                @if (disc.Length.HasValue && disc.Length > 0)
                                {
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-clock"></i> @formatLength(disc.Length)
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-muted small">
                                @(disc.FreeDbDiscId.HasValue ? disc.FreeDbDiscId.Value.ToString() : "—")
                            </td>
                            <td class="text-muted small text-truncate" style="max-width: 140px;">
                                @(string.IsNullOrWhiteSpace(disc.FreeDbId) ? "—" : disc.FreeDbId)
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@disc.DiscId"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i> Details
                                </a>
                                <a asp-action="Edit" asp-route-id="@disc.DiscId"
                                   class="btn btn-sm btn-outline-success">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@disc.DiscId"
                                   class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ======================================================================
         Mobile/Tablet Cards (< lg)
         ====================================================================== -->
    <div class="d-lg-none mb-4">
        <div class="row g-3">
            @foreach (var disc in Model.Items)
            {
                <div class="col-12 col-md-6">
                    <div class="mobile-artist-card">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <div class="brand-icon" style="width: 34px; height: 34px; font-size: 0.85rem;">
                                    <i class="bi bi-vinyl-fill"></i>
                                </div>
                                <div>
                                    <h3 class="artist-name mb-0">@disc.Name</h3>
                                    <div class="artist-sub">@disc.ArtistName</div>
                                </div>
                            </div>
                            <span class="badge-id">#@disc.DiscId</span>
                        </div>

                        <div class="d-flex flex-wrap gap-2 my-2 small">
                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 fw-semibold">
                                Disc @disc.DiscNo
                            </span>
                            @if (disc.Length.HasValue && disc.Length > 0)
                            {
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-clock"></i> @formatLength(disc.Length)
                                </span>
                            }
                            @if (disc.FreeDbDiscId.HasValue)
                            {
                                <span class="text-muted">FreeDb: @disc.FreeDbDiscId</span>
                            }
                        </div>

                        <div class="mobile-actions">
                            <a asp-action="Details" asp-route-id="@disc.DiscId"
                               class="btn btn-outline-primary">
                                <i class="bi bi-eye"></i> Details
                            </a>
                            <a asp-action="Edit" asp-route-id="@disc.DiscId"
                               class="btn btn-outline-success">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@disc.DiscId"
                               class="btn btn-outline-danger">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- ======================================================================
         Pagination
         ====================================================================== -->
    @if (Model.TotalPages > 1)
    {
        <div class="app-card p-3 mb-4">
            <!-- Desktop / Tablet -->
            <div class="d-none d-md-flex align-items-center justify-content-between flex-wrap gap-3">
                <div class="text-muted small">
                    Showing <strong>@((Model.CurrentPage - 1) * Model.PageSize + 1)</strong> to
                    <strong>@Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount)</strong> of
                    <strong>@Model.TotalCount</strong> discs
                </div>
                <nav aria-label="Disc pagination">
                    <ul class="pagination pagination-sm flex-wrap">
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@Model.SearchTerm">
                                <i class="bi bi-chevron-left"></i> Prev
                            </a>
                        </li>
                        @if (Model.HasPreviousBlock)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Index"
                                   asp-route-page="@Model.PreviousBlockFirstPage" asp-route-search="@Model.SearchTerm">&laquo; Prev 15</a>
                            </li>
                            <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                        }
                        @for (int p = Model.BlockStart; p <= Model.BlockEnd; p++)
                        {
                            <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-page="@p" asp-route-search="@Model.SearchTerm">@p</a>
                            </li>
                        }
                        @if (Model.HasNextBlock)
                        {
                            <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                            <li class="page-item">
                                <a class="page-link" asp-action="Index"
                                   asp-route-page="@Model.NextBlockFirstPage" asp-route-search="@Model.SearchTerm">Next 15 &raquo;</a>
                            </li>
                        }
                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@Model.SearchTerm">
                                Next <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>

            <!-- Mobile -->
            <div class="d-md-none">
                <div class="mobile-pagination-bar mb-2">
                    <a class="btn btn-outline-secondary @(!Model.HasPreviousPage ? "disabled" : "")"
                       asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@Model.SearchTerm">
                        <i class="bi bi-chevron-left"></i> Prev
                    </a>
                    <span class="badge bg-light text-dark border px-3 py-2 fs-6">Page @Model.CurrentPage of @Model.TotalPages</span>
                    <a class="btn btn-outline-secondary @(!Model.HasNextPage ? "disabled" : "")"
                       asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@Model.SearchTerm">
                        Next <i class="bi bi-chevron-right"></i>
                    </a>
                </div>
                <div class="text-center text-muted small mt-2">
                    Discs @((Model.CurrentPage - 1) * Model.PageSize + 1) &ndash; @Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount) of @Model.TotalCount
                </div>
            </div>
        </div>
    }
}
