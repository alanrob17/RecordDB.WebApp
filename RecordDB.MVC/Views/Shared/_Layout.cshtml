<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RecordDB</title>
    
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Bootstrap CSS & Theme Styles -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RecordDB.MVC.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-dark app-navbar mb-4">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon"><i class="bi bi-disc-fill"></i></span>
                    <span>RecordDB</span>
                </a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-md-0">
                        <!-- Home -->
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i> Home
                            </a>
                        </li>

                        <!-- Search DropDown -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="searchDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-search"></i> Search
                            </a>
                            <ul class="dropdown-menu shadow" aria-labelledby="searchDropdown">
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2" asp-area="" asp-controller="Artist" asp-action="Search">
                                        <i class="bi bi-person-fill text-primary"></i> Artist Search
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2" asp-area="" asp-controller="Record" asp-action="Search">
                                        <i class="bi bi-disc text-primary"></i> Record Search
                                    </a>
                                </li>
                                <li>
                                     <a class="dropdown-item d-flex align-items-center gap-2" asp-area="" asp-controller="Track" asp-action="Search">
                                         <i class="bi bi-music-note-list text-primary"></i> Track Search
                                     </a>
                                </li>
                                <li>
                                     <a class="dropdown-item d-flex align-items-center gap-2" asp-area="" asp-controller="Record" asp-action="Recorded">
                                         <i class="bi bi-calendar-event text-primary"></i> Recorded by Year
                                     </a>
                                </li>
                            </ul>
                        </li>

                        <!-- Maintenance DropDown (nested submenus) -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="maintenanceDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-gear-fill"></i> Maintenance
                            </a>
                            <ul class="dropdown-menu shadow" aria-labelledby="maintenanceDropdown" style="min-width: 200px;">

                                <!-- Artists submenu -->
                                <li class="dropdown-submenu">
                                    <a class="dropdown-item dropdown-toggle d-flex align-items-center gap-2" href="#" role="button">
                                        <i class="bi bi-people-fill text-primary"></i>
                                        <span>Artists</span>
                                    </a>
                                    <ul class="dropdown-menu shadow">
                                        <li><h6 class="dropdown-header"><i class="bi bi-people-fill me-1"></i> Artists</h6></li>
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="Artist" asp-action="Index">
                                                <i class="bi bi-list-ul me-2 text-primary"></i>Artist List
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="Artist" asp-action="Create">
                                                <i class="bi bi-plus-circle me-2 text-primary"></i>Create an Artist
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="Artist" asp-action="EditArtist">
                                                <i class="bi bi-pencil me-2 text-primary"></i>Edit an Artist
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="Artist" asp-action="DeleteArtist">
                                                <i class="bi bi-trash me-2 text-danger"></i>Delete an Artist
                                            </a>
                                        </li>
                                    </ul>
                                </li>

                                <!-- Records submenu -->
                                <li class="dropdown-submenu">
                                    <a class="dropdown-item dropdown-toggle d-flex align-items-center gap-2" href="#" role="button">
                                        <i class="bi bi-disc text-primary"></i>
                                        <span>Records</span>
                                    </a>
                                    <ul class="dropdown-menu shadow">
                                        <li><h6 class="dropdown-header"><i class="bi bi-disc me-1"></i> Records</h6></li>
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="Record" asp-action="Index">
                                                <i class="bi bi-list-ul me-2 text-primary"></i>Record List
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="Record" asp-action="Create">
                                                <i class="bi bi-plus-circle me-2 text-primary"></i>Create a Record
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="Record" asp-action="EditRecord">
                                                <i class="bi bi-pencil me-2 text-primary"></i>Edit a Record
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="Record" asp-action="DeleteRecord">
                                                <i class="bi bi-trash me-2 text-danger"></i>Delete a Record
                                            </a>
                                        </li>
                                    </ul>
                                </li>

                                <!-- Discs submenu -->
                                <li class="dropdown-submenu">
                                    <a class="dropdown-item dropdown-toggle d-flex align-items-center gap-2" href="#" role="button">
                                        <i class="bi bi-vinyl-fill text-primary"></i>
                                        <span>Discs</span>
                                    </a>
                                    <ul class="dropdown-menu shadow">
                                        <li><h6 class="dropdown-header"><i class="bi bi-vinyl-fill me-1"></i> Discs</h6></li>
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="Disc" asp-action="Index">
                                                <i class="bi bi-list-ul me-2 text-primary"></i>Disc List
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="Disc" asp-action="Create">
                                                <i class="bi bi-plus-circle me-2 text-primary"></i>Create a Disc
                                            </a>
                                        </li>
                                    </ul>
                                </li>

                                <!-- Tracks submenu -->
                                <li class="dropdown-submenu">
                                    <a class="dropdown-item dropdown-toggle d-flex align-items-center gap-2" href="#" role="button">
                                        <i class="bi bi-music-note-list text-primary"></i>
                                        <span>Tracks</span>
                                    </a>
                                    <ul class="dropdown-menu shadow">
                                        <li><h6 class="dropdown-header"><i class="bi bi-music-note-list me-1"></i> Tracks</h6></li>
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="Track" asp-action="Index">
                                                <i class="bi bi-list-ul me-2 text-primary"></i>Track List
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="Track" asp-action="Create">
                                                <i class="bi bi-plus-circle me-2 text-primary"></i>Create a Track
                                            </a>
                                        </li>
                                    </ul>
                                </li>

                            </ul>
                        </li>

                        <!-- Statistics DropDown -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="statsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-bar-chart-fill"></i> Statistics
                            </a>
                            <ul class="dropdown-menu shadow" aria-labelledby="statsDropdown">
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2" asp-area="" asp-controller="Total" asp-action="TotalCosts">
                                        <i class="bi bi-pie-chart-fill text-primary"></i> Artist Totals
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2" asp-area="" asp-controller="Statistics" asp-action="Index">
                                        <i class="bi bi-graph-up text-primary"></i> Statistics
                                    </a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center">
                        <span class="badge bg-dark border border-secondary text-light px-3 py-2 rounded-pill small">
                            <i class="bi bi-music-note-beamed text-primary me-1"></i> Music Catalogue
                        </span>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer py-3 mt-auto">
        <div class="container text-center text-md-start d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
            <div>
                &copy; 2026 <strong>RecordDB</strong>
            </div>
            <div>
                <a asp-area="" asp-controller="Artist" asp-action="Index" class="text-muted text-decoration-none">
                    <i class="bi bi-collection-play me-1"></i>Artist List
                </a> &mdash; 
                <a asp-area="" asp-controller="Record" asp-action="Index" class="text-muted text-decoration-none">
                    <i class="bi bi-collection-play me-1"></i>Record List
                </a> &mdash; 
                <a asp-area="" asp-controller="Track" asp-action="Search" class="text-muted text-decoration-none">
                    <i class="bi bi-collection-play me-1"></i>Track List
                </a>

            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Nested submenu click-toggle (for mobile / touch where :hover is unavailable)
        document.querySelectorAll('.dropdown-submenu > .dropdown-toggle').forEach(function (toggle) {
            toggle.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                var parentLi = this.closest('.dropdown-submenu');
                var isShown = parentLi.classList.contains('show');
                // Close all sibling submenus
                parentLi.closest('ul').querySelectorAll('.dropdown-submenu.show').forEach(function (el) {
                    el.classList.remove('show');
                });
                if (!isShown) {
                    parentLi.classList.add('show');
                }
            });
        });
        // Close submenus when the parent dropdown closes
        document.querySelectorAll('[data-bs-toggle="dropdown"]').forEach(function (dd) {
            dd.addEventListener('hidden.bs.dropdown', function () {
                document.querySelectorAll('.dropdown-submenu.show').forEach(function (el) {
                    el.classList.remove('show');
                });
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
