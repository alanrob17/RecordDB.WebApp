@model RecordDB.Shared.DTOs.CreateArtistDto

@{
    ViewData["Title"] = "Create Artist";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8">
        <!-- Back Navigation -->
        <div class="mb-3">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> Back to Artists
            </a>
        </div>

        <div class="app-card">
            <!-- Header -->
            <div class="app-card-header colored-primary">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-person-plus-fill fs-4 text-white"></i>
                    <div>
                        <h1 class="h4 mb-0 fw-bold text-white">Add New Artist</h1>
                        <span class="text-white-50 small">Fill in the artist information below</span>
                    </div>
                </div>
            </div>

            <!-- Form Body -->
            <div class="app-card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger d-flex align-items-center gap-2 mb-3" role="alert">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <div>Please check the errors below.</div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-sm-6">
                            <label asp-for="FirstName" class="form-label">First Name</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted">
                                    <i class="bi bi-person"></i>
                                </span>
                                <input asp-for="FirstName" class="form-control" placeholder="e.g. David" autofocus />
                            </div>
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-sm-6">
                            <label asp-for="LastName" class="form-label">Last Name</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted">
                                    <i class="bi bi-person"></i>
                                </span>
                                <input asp-for="LastName" class="form-control" placeholder="e.g. Bowie" />
                            </div>
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Biography" class="form-label">Biography</label>
                        <textarea asp-for="Biography" class="form-control" rows="6" 
                                  placeholder="Write a brief biography, musical background, or album notes..."></textarea>
                        <span asp-validation-for="Biography" class="text-danger small"></span>
                        <div class="form-text text-muted small">
                            Optional. You can add or edit biographical details later.
                        </div>
                    </div>

                    <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 pt-2 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary order-2 order-sm-1">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-primary order-1 order-sm-2">
                            <i class="bi bi-check2-circle"></i> Create Artist
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
