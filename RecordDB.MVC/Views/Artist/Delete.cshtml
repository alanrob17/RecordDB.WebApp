@model RecordDB.Shared.DTOs.ArtistDto

@{
    ViewData["Title"] = $"Delete {Model.Name}";
    var initial = !string.IsNullOrEmpty(Model.Name) 
        ? Model.Name.Trim().Substring(0, 1).ToUpper() 
        : (!string.IsNullOrEmpty(Model.LastName) ? Model.LastName.Trim().Substring(0, 1).ToUpper() : "?");
}

<div class="row justify-content-center">
    <div class="col-12 col-md-9 col-lg-7">
        <!-- Back Navigation -->
        <div class="mb-3">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> Back to Artists
            </a>
        </div>

        <div class="app-card border-danger">
            <!-- Danger Header -->
            <div class="app-card-header colored-danger">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-octagon-fill fs-4 text-white"></i>
                    <div>
                        <h1 class="h4 mb-0 fw-bold text-white">Confirm Deletion</h1>
                        <span class="text-white-50 small">Warning: This action cannot be reversed</span>
                    </div>
                </div>
            </div>

            <!-- Card Body -->
            <div class="app-card-body">
                <div class="alert alert-danger bg-danger bg-opacity-10 border-danger border-opacity-25 text-danger d-flex align-items-start gap-2 mb-4">
                    <i class="bi bi-exclamation-triangle-fill fs-5 mt-1 flex-shrink-0"></i>
                    <div>
                        <strong>Are you sure you want to delete this artist?</strong>
                        <div class="small mt-1">This will permanently remove <strong>@Model.Name</strong> from the RecordDB database catalog.</div>
                    </div>
                </div>

                <!-- Artist Profile Card Preview -->
                <div class="p-3 bg-light rounded-3 border mb-3">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="artist-avatar">@initial</div>
                        <div>
                            <h2 class="h5 mb-0 fw-bold text-dark">@Model.Name</h2>
                            <span class="badge-id">Artist ID: #@Model.ArtistId</span>
                        </div>
                    </div>

                    <dl class="row mb-0 small">
                        <dt class="col-4 text-muted">First Name:</dt>
                        <dd class="col-8 text-dark mb-1">@(string.IsNullOrWhiteSpace(Model.FirstName) ? "—" : Model.FirstName)</dd>

                        <dt class="col-4 text-muted">Last Name:</dt>
                        <dd class="col-8 text-dark mb-1">@(string.IsNullOrWhiteSpace(Model.LastName) ? "—" : Model.LastName)</dd>

                        @if (!string.IsNullOrEmpty(Model.Biography))
                        {
                            <dt class="col-4 text-muted">Biography:</dt>
                            <dd class="col-8 text-muted fst-italic mb-0">
                                @(Model.Biography.Length > 80 ? Model.Biography[..80] + "…" : Model.Biography)
                            </dd>
                        }
                    </dl>
                </div>

                <!-- Form & Actions -->
                <form asp-action="Delete" method="post">
                    <input type="hidden" name="id" value="@Model.ArtistId" />

                    <div class="d-flex flex-column flex-sm-row justify-content-between gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary order-3 order-sm-1">
                            Cancel
                        </a>

                        <div class="d-flex gap-2 order-1 order-sm-2">
                            <a asp-action="Details" asp-route-id="@Model.ArtistId" class="btn btn-outline-primary flex-fill">
                                <i class="bi bi-eye"></i> Details
                            </a>
                            <button type="submit" class="btn btn-danger flex-fill">
                                <i class="bi bi-trash-fill"></i> Permanently Delete
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
