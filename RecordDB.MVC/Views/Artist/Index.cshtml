@model RecordDB.MVC.Models.PaginatedViewModel<RecordDB.Shared.DTOs.ArtistDto>

@{
    ViewData["Title"] = "Artists";
}

<!-- Page Header & Action Bar -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1 fw-bold text-dark d-flex align-items-center gap-2">
            <i class="bi bi-people text-primary"></i> Artists
            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill fs-6 fw-semibold">
                @Model.TotalCount @(Model.TotalCount == 1 ? "artist" : "artists")
            </span>
        </h1>
        <p class="text-muted mb-0 small">Browse, search, and manage musicians and groups in the RecordDB catalogue.</p>
    </div>
    
    <div class="d-flex flex-column flex-sm-row gap-2">
        <!-- Search form -->
        <form method="get" asp-action="Index" class="d-flex gap-1">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" name="search" value="@Model.SearchTerm" class="form-control border-start-0" 
                       placeholder="Search artists..." style="min-width: 300px;" />
                @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary border-start-0" title="Clear search">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
                <button type="submit" class="btn btn-primary">Search</button>
            </div>
        </form>

        <a asp-action="Create" class="btn btn-primary text-nowrap">New Artist</a>
    </div>
</div>

<!-- Success Banner -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-check-circle-fill fs-5 text-success"></i>
        <div>@TempData["Success"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Items.Any())
{
    <div class="app-card text-center py-5 px-3">
        <div class="mb-3">
            <i class="bi bi-search text-muted" style="font-size: 3rem;"></i>
        </div>
        <h4 class="fw-semibold">No artists found</h4>
        <p class="text-muted mb-3">
            @(string.IsNullOrWhiteSpace(Model.SearchTerm) 
                ? "Your artist catalogue is currently empty." 
                : $"No artists matched \"{Model.SearchTerm}\".")
        </p>
        <div>
            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
            {
                <a asp-action="Index" class="btn btn-outline-secondary me-2">
                    <i class="bi bi-arrow-left"></i> View All Artists
                </a>
            }
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Add New Artist
            </a>
        </div>
    </div>
}
else
{
    <!-- ======================================================================
         Desktop & Laptop View: Clean modern table (Visible on Large screens)
         ====================================================================== -->
    <div class="app-card d-none d-lg-block mb-4">
        <div class="table-responsive">
            <table class="table table-custom align-middle">
                <thead>
                    <tr>
                        <th>Artist</th>
                        <th>Biography</th>
                        <th class="text-end" style="width: 260px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var artist in Model.Items)
                    {
                        var initial = !string.IsNullOrEmpty(artist.Name) 
                            ? artist.Name.Trim().Substring(0, 1).ToUpper() 
                            : (!string.IsNullOrEmpty(artist.LastName) ? artist.LastName.Trim().Substring(0, 1).ToUpper() : "?");

                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div>
                                        <div class="fw-semibold text-dark">@artist.Name</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(artist.Biography))
                                {
                                    <span class="text-muted small" title="@artist.Biography">
                                        @(artist.Biography.Length > 70 
                                            ? artist.Biography[..70] + "…" 
                                            : artist.Biography)
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic small">No biography</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@artist.ArtistId"
                                   class="btn btn-sm btn-outline-primary" title="View details">
                                    <i class="bi bi-eye"></i> Details
                                </a>
                                <a asp-action="Edit" asp-route-id="@artist.ArtistId"
                                   class="btn btn-sm btn-outline-success" title="Edit artist">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@artist.ArtistId"
                                   class="btn btn-sm btn-outline-danger" title="Delete artist">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ======================================================================
         Tablet & Mobile View: Responsive Touch-Friendly Cards (Visible on Mobile/Tablet)
         ====================================================================== -->
    <div class="d-lg-none mb-4">
        <div class="row g-3">
            @foreach (var artist in Model.Items)
            {
                var initial = !string.IsNullOrEmpty(artist.Name) 
                    ? artist.Name.Trim().Substring(0, 1).ToUpper() 
                    : (!string.IsNullOrEmpty(artist.LastName) ? artist.LastName.Trim().Substring(0, 1).ToUpper() : "?");

                <div class="col-12 col-md-6">
                    <div class="mobile-artist-card">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <div class="artist-avatar">@initial</div>
                                <div>
                                    <h3 class="artist-name mb-0">@artist.Name</h3>
                                    @if (!string.IsNullOrEmpty(artist.FirstName) || !string.IsNullOrEmpty(artist.LastName))
                                    {
                                        <div class="artist-sub">
                                            @artist.FirstName @artist.LastName
                                        </div>
                                    }
                                </div>
                            </div>
                            <span class="badge-id">#@artist.ArtistId</span>
                        </div>

                        <div class="artist-bio">
                            @if (!string.IsNullOrEmpty(artist.Biography))
                            {
                                @(artist.Biography.Length > 110 
                                    ? artist.Biography[..110] + "…" 
                                    : artist.Biography)
                            }
                            else
                            {
                                <span class="text-muted fst-italic">No biography provided.</span>
                            }
                        </div>

                        <div class="mobile-actions">
                            <a asp-action="Details" asp-route-id="@artist.ArtistId"
                               class="btn btn-outline-primary">
                                <i class="bi bi-eye"></i> Details
                            </a>
                            <a asp-action="Edit" asp-route-id="@artist.ArtistId"
                               class="btn btn-outline-success">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@artist.ArtistId"
                               class="btn btn-outline-danger">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- ======================================================================
         Responsive Pagination Section
         ====================================================================== -->
    @if (Model.TotalPages > 1)
    {
        <div class="app-card p-3 mb-4">
            <!-- Tablet & Desktop Pagination Bar (Full 15-button window) -->
            <div class="d-none d-md-flex align-items-center justify-content-between flex-wrap gap-3">
                <div class="text-muted small">
                    Showing <strong>@((Model.CurrentPage - 1) * Model.PageSize + 1)</strong> to 
                    <strong>@Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount)</strong> of 
                    <strong>@Model.TotalCount</strong> artists
                </div>

                <nav aria-label="Artist pagination desktop">
                    <ul class="pagination pagination-sm flex-wrap">
                        <!-- Single page Prev -->
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@Model.SearchTerm"
                               aria-label="Previous">
                                <i class="bi bi-chevron-left"></i> Prev
                            </a>
                        </li>

                        <!-- Previous Block of 15 -->
                        @if (Model.HasPreviousBlock)
                        {
                            <li class="page-item">
                                <a class="page-link"
                                   asp-action="Index" asp-route-page="@Model.PreviousBlockFirstPage" asp-route-search="@Model.SearchTerm"
                                   title="Go to pages @Model.PreviousBlockFirstPage – @(Model.PreviousBlockFirstPage + Model.BlockSize - 1)">
                                    &laquo; Prev 15
                                </a>
                            </li>
                            <li class="page-item disabled">
                                <span class="page-link">&hellip;</span>
                            </li>
                        }

                        <!-- Page number buttons (up to 15 in current block) -->
                        @for (int p = Model.BlockStart; p <= Model.BlockEnd; p++)
                        {
                            <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@Model.SearchTerm">@p</a>
                            </li>
                        }

                        <!-- Next Block of 15 -->
                        @if (Model.HasNextBlock)
                        {
                            <li class="page-item disabled">
                                <span class="page-link">&hellip;</span>
                            </li>
                            <li class="page-item">
                                <a class="page-link"
                                   asp-action="Index" asp-route-page="@Model.NextBlockFirstPage" asp-route-search="@Model.SearchTerm"
                                   title="Go to pages @Model.NextBlockFirstPage – @(Math.Min(Model.NextBlockFirstPage + Model.BlockSize - 1, Model.TotalPages))">
                                    Next 15 &raquo;
                                </a>
                            </li>
                        }

                        <!-- Single page Next -->
                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@Model.SearchTerm"
                               aria-label="Next">
                                Next <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>

            <!-- Mobile Compact Pagination Bar (Screen-friendly touch targets) -->
            <div class="d-md-none">
                <div class="mobile-pagination-bar mb-2">
                    <a class="btn btn-outline-secondary @(!Model.HasPreviousPage ? "disabled" : "")"
                       asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@Model.SearchTerm">
                        <i class="bi bi-chevron-left"></i> Prev
                    </a>
                    
                    <span class="badge bg-light text-dark border px-3 py-2 fs-6">
                        Page @Model.CurrentPage of @Model.TotalPages
                    </span>

                    <a class="btn btn-outline-secondary @(!Model.HasNextPage ? "disabled" : "")"
                       asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@Model.SearchTerm">
                        Next <i class="bi bi-chevron-right"></i>
                    </a>
                </div>

                @if (Model.TotalBlocks > 1)
                {
                    <div class="d-flex justify-content-between gap-2 mt-2 pt-2 border-top">
                        @if (Model.HasPreviousBlock)
                        {
                            <a class="btn btn-sm btn-outline-primary flex-fill"
                               asp-action="Index" asp-route-page="@Model.PreviousBlockFirstPage" asp-route-search="@Model.SearchTerm">
                                &laquo; Prev 15 Pages
                            </a>
                        }
                        @if (Model.HasNextBlock)
                        {
                            <a class="btn btn-sm btn-outline-primary flex-fill"
                               asp-action="Index" asp-route-page="@Model.NextBlockFirstPage" asp-route-search="@Model.SearchTerm">
                                Next 15 Pages &raquo;
                            </a>
                        }
                    </div>
                }

                <div class="text-center text-muted small mt-2">
                    Records @((Model.CurrentPage - 1) * Model.PageSize + 1) &ndash; @Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount) of @Model.TotalCount
                </div>
            </div>
        </div>
    }
}
